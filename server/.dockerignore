.git/
node_modules/
server/engine/node_modules/
server/gateway/node_modules/
server/webclient/node_modules/
sdk/node_modules/

# Webclient bundle is built inside the image (see Dockerfile); never ship the local
# build artifacts, or a deploy could silently serve a stale client.
server/webclient/out/

# Dirs not needed for production
benchmark/
bots/
jobs/
learnings/
mcp/
scripts/

# Dev/test files inside server
server/scripts/
server/bot_arcs/
server/bots/
server/runs/
server/docs/
**/*.log
**/.DS_Store

# Large files not needed for production
server/engine/screenshots/
sdk/collision-data.json
sdk/test/

# Local dev state: never seed the prod volume with local saves/db, and never let
# stale local pack output short-circuit the in-image `bun run build` (packs must be
# rebuilt from server/content, same reasoning as server/webclient/out above).
server/engine/data/players/
server/engine/db.sqlite
server/engine/data/pack/

# Config files at parent level
*.md
*.toml
*.json
*.lock
analogy/
