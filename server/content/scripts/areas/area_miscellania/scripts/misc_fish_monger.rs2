[opnpc1,misc_fish_monger]
if (getqueue(stolen_from_stall_miscfish) > 0) {
    npc_say("It's them!"); // from osrs
    p_delay(1);
    npc_say("Guards, guards!"); // from osrs too
    npc_huntall(npc_coord, 5, 0);
    while (npc_findnext = true) {
        if (npc_param(market_guard) = ^true
             & npc_getmode ! opplayer2 & lineofsight(npc_coord, coord) = true) {
            ~npc_retaliate(0);
        }
    }
    return;
}
if(%misc_quest = ^misc_complete) ~chatnpc("<p,neutral>Greetings, Your Royal Highness. Get your fresh fish here!");
else ~chatnpc("<p,neutral>Greetings, Sir. Get your fresh fish here!");
~chatnpc("<p,shifty>I've heard that the Etceterian fish is stored in a cow shed.");
~openshop_activenpc;

[opnpc3,misc_fish_monger]
if (getqueue(stolen_from_stall_miscfish) > 0) {
    @stall_owner_alert_guards;
    return;
}
~openshop_activenpc;
