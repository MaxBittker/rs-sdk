[opnpc1,etc_fish_monger]
if (getqueue(stolen_from_stall_etcfish) > 0) {
    npc_say("Get away from me!"); // from osrs
    p_delay(1);
    npc_say("Guards guards!"); // from osrs too
    npc_huntall(npc_coord, 5, 0);
    while (npc_findnext = true) {
        if (npc_param(market_guard) = ^true
             & npc_getmode ! opplayer2 & lineofsight(npc_coord, coord) = true) {
            ~npc_retaliate(0);
        }
    }
    return;
}
~chatnpc("<p,neutral>Welcome <~get_viking_name>. My fish is fresher than any in Miscellania!");
~openshop_activenpc;

[opnpc3,etc_fish_monger]
if (getqueue(stolen_from_stall_etcfish) > 0) {
    @stall_owner_alert_guards;
    return;
}
~openshop_activenpc;
