[opnpc1,etc_veg_monger]
if (getqueue(stolen_from_stall_etcveg) > 0) {
    npc_say("You've got some nerve coming back here!"); // from osrs
    p_delay(1);
    npc_say("Guards guards!"); // from osrs too
    npc_huntall(npc_coord, 5, 0);
    while (npc_findnext = true) {
        if (npc_param(market_guard) = ^true
             & npc_getmode ! opplayer2 & lineofsight(npc_coord, coord) = true) {
            ~npc_retaliate(0);
        }
    }
    return;
}
~chatnpc("<p,neutral>Hello <~get_viking_name>. You've come to the right place for yer greens!");
~openshop_activenpc;

[opnpc3,etc_veg_monger]
if (getqueue(stolen_from_stall_etcveg) > 0) {
    @stall_owner_alert_guards;
    return;
}
~openshop_activenpc;
