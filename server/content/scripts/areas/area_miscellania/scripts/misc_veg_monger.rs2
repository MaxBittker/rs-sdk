[opnpc1,misc_veg_monger]
if (getqueue(stolen_from_stall_miscveg) > 0) {
    npc_say("That thief <~get_viking_name> has come back!"); // from osrs
    p_delay(1);
    npc_say("Guards, guards!"); // from osrs too
    npc_huntall(npc_coord, 5, 0);
    while (npc_findnext = true) {
        if (npc_param(market_guard) = ^true
             & npc_getmode ! opplayer2 & lineofsight(npc_coord, coord) = true) {
            ~npc_retaliate(0);
        }
    }
    return;
}
if(%misc_quest = ^misc_complete) ~chatnpc("<p,neutral>Welcome, Your Royal Highness. I sell only the finest and freshest vegetables!");
else ~chatnpc("<p,neutral>Welcome, Sir. I sell only the finest and freshest vegetables!");
~openshop_activenpc;

[opnpc3,misc_veg_monger]
if (getqueue(stolen_from_stall_miscveg) > 0) {
    @stall_owner_alert_guards;
    return;
}
~openshop_activenpc;
