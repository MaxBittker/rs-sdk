[oploc1,karam_dungeon_bamboo_logbalance1]
if(stat(agility) < 30) {
    ~mesbox("You need an Agility level of 30 to cross the log.");
    return;
}
@cross_karam_dungeon_log(1, 0_41_148_57_35);

[oploc1,karam_dungeon_bamboo_logbalance3]
@cross_karam_dungeon_log(-1, 0_42_148_0_36);

[label,cross_karam_dungeon_log](int $x_dist, coord $fail_coord)
p_teleport(movecoord(loc_coord, multiply($x_dist, -1), 0, 0));
p_arrivedelay;
mes("You walk carefully across the slippery log...");
~set_readywalk_bas(human_walk_logbalance_ready, human_walk_logbalance);
~forcemove(movecoord(coord, $x_dist, 0, 0));
sound_synth(log_balance, 4, 0);
~forcemove(movecoord(coord, $x_dist, 0, 0));
if(stat_random(agility, 210, 275) = false) {
    mes("...You lose your footing and fall into the lava.");
    facesquare(movecoord(coord, 0, 0, $x_dist));
    anim(human_walk_logbalance_stumble, 0);
    sound_synth(stumble_loop, 10, 0);
    strongqueue(damage_player, 0, add(divide(stat(hitpoints), 10), 1));
    p_delay(0);
    ~update_bas;
    sound_synth(sizzle, 1, 0);
    p_telejump($fail_coord);
    return;
}
sound_synth(log_balance, 2, 0);
~forcemove(movecoord(coord, multiply(2,$x_dist), 0, 0));
mes("...You make it safely to the other side.");
~forcemove(movecoord(coord, $x_dist, 0, 0));
~update_bas;
stat_advance(agility, 100);

[oploc1,karam_dungeon_pipe]
def_int $mod = 1;
def_int $dir = ^exact_north;
def_coord $next_pipe = 0_42_148_10_26;
def_coord $start = 0_42_148_10_20;
if(coordz(coord) > coordz(loc_coord)) {
    if(stat(agility) < 34) {
        ~mesbox("You need an Agility level of 34 to squeeze through the pipe.");
        return;
    }
    $mod = -1;
    $dir = ^exact_south;
    $next_pipe = 0_42_148_10_21;
    $start = 0_42_148_10_28;
}
~forcewalk2($start);
if(%karam_dungeon_pipe_used2 >= map_clock) {
    mes("The pipe is being used"); // todo: confirm, using the same as gnome course
    return;
}
%karam_dungeon_pipe_used2 = calc(map_clock + 9);
~agility_exactmove(human_doublepipesqueeze, 30, 3, coord, movecoord(coord, 0, 0, multiply(3, $mod)), 30, 126, $dir, true);
sound_synth(squeeze_in, 1, 0);
p_teleport(movecoord(coord, 0, 0, multiply(2, $mod)));
p_delay(0);
~change_merged_loc($next_pipe);
~agility_exactmove(human_doublepipesqueeze, 30, 3, coord, movecoord(coord, 0, 0, multiply(3, $mod)), 30, 126, $dir, true);
sound_synth(squeeze_in, 1, 0);
stat_advance(agility, 100);

[oploc1,karam_dungeon_pipe2]
def_int $mod = -1;
def_int $dir = ^exact_south;
def_coord $next_pipe = 0_41_149_31_31;
def_coord $start = 0_41_149_31_37;
if(coordz(coord) <= coordz(loc_coord)) {
    if(stat(agility) < 22) {
        ~mesbox("You need an Agility level of 22 to squeeze through the pipe.");
        return;
    }
    $mod = 1;
    $dir = ^exact_north;
    $start = 0_41_149_31_30;
    $next_pipe = 0_41_149_31_35;
}
~forcewalk2($start);
if(%karam_dungeon_pipe_used >= map_clock) {
    mes("The pipe is being used"); // todo: confirm, using the same as gnome course
    return;
}
%karam_dungeon_pipe_used = calc(map_clock + 9);
~agility_exactmove(human_doublepipesqueeze, 30, 3, coord, movecoord(coord, 0, 0, multiply(3, $mod)), 30, 126, $dir, true);
sound_synth(squeeze_in, 1, 0);
p_teleport(movecoord(coord, 0, 0, $mod));
p_delay(0);
~change_merged_loc($next_pipe);
~agility_exactmove(human_doublepipesqueeze, 30, 3, coord, movecoord(coord, 0, 0, multiply(3, $mod)), 30, 126, $dir, true);
sound_synth(squeeze_in, 1, 0);
stat_advance(agility, 85);
