[label,book_flip_page](int $page_direction, int $min_page, int $max_page, proc $proc)
%book_page = add(%book_page, $page_direction);
if (%book_page > $max_page) {
    %book_page = $max_page;
} else if (%book_page < $min_page) {
    %book_page = $min_page;
}

if (%book_page = $min_page) {
    if_sethide(book:page_left_button, true);
} else {
    if_sethide(book:page_left_button, false);
}

if (%book_page = $max_page) {
    if_sethide(book:page_right_button, true);
} else {
    if_sethide(book:page_right_button, false);
}

gosub($proc);
