if_sethide(book:page_left_index_4, true);
if_settext(book:page_left_text_5, split_get($page, 4));
if_sethide(book:page_left_index_5, true);
if_settext(book:page_left_text_6, split_get($page, 5));
if_sethide(book:page_left_index_6, true);
if_settext(book:page_left_text_7, split_get($page, 6));
if_sethide(book:page_left_index_7, true);
if_settext(book:page_left_text_8, split_get($page, 7));
if_sethide(book:page_left_index_8, true);
if_settext(book:page_left_text_9, split_get($page, 8));
if_sethide(book:page_left_index_9, true);
if_settext(book:page_left_text_10, split_get($page, 9));
if_sethide(book:page_left_index_10, true);
if_settext(book:page_left_text_11, split_get($page, 10));
if_sethide(book:page_left_index_11, true);
if_settext(book:page_right_text_1, split_get($page, 11));
if_sethide(book:page_right_index_1, true);
if_settext(book:page_right_text_2, split_get($page, 12));
if_sethide(book:page_right_index_2, true);
if_settext(book:page_right_text_3, split_get($page, 13));
if_sethide(book:page_right_index_3, true);
if_settext(book:page_right_text_4, split_get($page, 14));
if_sethide(book:page_right_index_4, true);
if_settext(book:page_right_text_5, split_get($page, 15));
if_sethide(book:page_right_index_5, true);
if_settext(book:page_right_text_6, split_get($page, 16));
if_sethide(book:page_right_index_6, true);
if_settext(book:page_right_text_7, split_get($page, 17));
if_sethide(book:page_right_index_7, true);
if_settext(book:page_right_text_8, split_get($page, 18));
if_sethide(book:page_right_index_8, true);
if_settext(book:page_right_text_9, split_get($page, 19));
if_sethide(book:page_right_index_9, true);
if_settext(book:page_right_text_10, split_get($page, 20));
if_sethide(book:page_right_index_10, true);
if_settext(book:page_right_text_11, split_get($page, 21));
if_sethide(book:page_right_index_11, true);
if_settext(book:book_title, $title);
if_openmain(book);

// its written this way to perserve order that osrs sends them
[proc,book_page_obj](string $title, component $obj_com, namedobj $obj, int $zoom, int $page)
if_settext(book:page_left_text_1, split_get($page, 0));
if ($obj_com = book:page_left_model_1) {
    if_sethide(book:page_left_index_1, false);
    if_setobject(book:page_left_model_1, $obj, $zoom);
} else {
    if_sethide(book:page_left_index_1, true);
}
