// returns space taken up when moving items from a secondary inventory AND a primary inventory into another primary inventory
[proc,.both_moveallinv_itemspace](inv $from_inv1, inv $from_inv2, inv $to_inv)(int)
def_int $space_needed = 0;

def_obj $obj = null;
def_int $obj_num = 0;
def_int $stack_sum = 0;
def_int $i = 0;
while ($i < .inv_size($from_inv1)) {
    $obj = .inv_getobj($from_inv1, $i);
    $obj_num = .inv_getnum($from_inv1, $i);
    if ($obj ! null) {
        if (oc_stackable($obj) = true) {
            $stack_sum = add($obj_num, inv_total($from_inv2, $obj));
            if ($stack_sum < 0) {
                return(add(inv_size($to_inv), 1)); // fail
            } else if (.inv_itemspace($to_inv, $obj, $stack_sum, .inv_size($to_inv)) = false) {
                return(add(.inv_size($to_inv), 1)); // fail
            } else if (.inv_total($to_inv, $obj) < 1) {
                $space_needed = add($space_needed, 1);
            }
        } else {
            $space_needed = add($space_needed, 1);
        }
    }
    $i = add($i, 1);
}

$obj = null;
$obj_num = 0;
$i = 0;
while ($i < inv_size($from_inv2)) {
    $obj = inv_getobj($from_inv2, $i);
    $obj_num = inv_getnum($from_inv2, $i);
    if ($obj ! null) {
        if (oc_stackable($obj) = true) {
            if (.inv_total($from_inv1, $obj) < 1) {
                if (.inv_itemspace($to_inv, $obj, $obj_num, .inv_size($to_inv)) = false) {
                    return(add(.inv_size($to_inv), 1)); // fail
                } else if (.inv_total($to_inv, $obj) < 1) {
                    $space_needed = add($space_needed, 1);
                }
            }
        } else {
            $space_needed = add($space_needed, 1);
        }
    }
    $i = add($i, 1);
}
return($space_needed);

[proc,obj_gettotal](obj $obj)(int)
def_int $total = calc(inv_total(inv, $obj) + inv_total(bank, $obj) + inv_total(worn, $obj));
return($total);

[proc,obj_gettotalcat](category $obj_cat)(int)
def_int $total = calc(inv_totalcat(inv, $obj_cat) + inv_totalcat(bank, $obj_cat) + inv_totalcat(worn, $obj_cat));
return($total);

[proc,inv_slotspace](inv $from_inv, inv $to_inv, enum $slots)(boolean)
def_int $space_needed = 0;
def_int $i = 0;
def_int $size = inv_size($from_inv);
while ($i < enum_getoutputcount($slots)) {
    def_obj $obj = inv_getobj($from_inv, enum(int, int, $slots, $i));
    def_int $obj_num  = inv_getnum($from_inv, enum(int, int, $slots, $i));
    if ($obj ! null) {
        if (oc_stackable($obj) = true) {
            if (inv_total($to_inv, $obj) < 1) {
                $space_needed = add($space_needed, 1);
            } else if (inv_itemspace($to_inv, $obj, $obj_num, $size) = false) {
                return(false);
            }
        } else {
            $space_needed = add($space_needed, 1);
        }
    }
    $i = add($i, 1);
}
if ($space_needed > inv_freespace($to_inv)) {
    return(false);
}
return(true);

// reorganize all of the slots towards the left of the inv.
[proc,reorganize_inv](inv $inv)
def_int $size = inv_size($inv);
def_int $count = 0;

while ($count < $size) {
    def_int $slot_count = inv_getnum($inv, $count);

    if ($slot_count = 0) {
        def_int $peek_slot = ~inv_peek_next_available_obj_slot($inv, $count);

        if ($peek_slot = -1) {
            $count = add($size, 1);
        } else {
            inv_movetoslot($inv, $inv, $peek_slot, $count);
            $count = add($count, 1);
        }
    } else {
        $count = add($count, 1);
    }
}

// used to check for any obj slots that are ahead of the input slot.
// returns the slot or -1 if none available.
[proc,inv_peek_next_available_obj_slot](inv $inv, int $from_slot)(int)
def_int $size = inv_size($inv);
def_int $count = $from_slot;
def_int $slot = -1;

while ($count < $size) {
    def_int $slot_count = inv_getnum($inv, $count);
    if ($slot_count = 0) {
        $count = add($count, 1);
    } else {
        $slot = $count;
        $count = add($size, 1);
    }
}
return($slot);

[proc,del_all_if_exists](inv $inv, namedobj $obj)
def_int $total = inv_total($inv, $obj);
if ($total > 0) {
    inv_del($inv, $obj, $total);
}

// Deletes a list of items from an inventory
[proc,inv_delenum](inv $inv, enum $enum)
def_int $i = 0;
while ($i < enum_getoutputcount($enum)) {
    inv_del($inv, enum(int, obj, $enum, $i), ^max_32bit_int);
    $i = add($i, 1);
}

[proc,inv_getslot](inv $inv, obj $obj)(int)
def_int $i = 0;
while ($i < inv_size($inv)) {
    if (inv_getobj($inv, $i) = $obj) return($i);
    $i = add($i, 1);
}
return(null);


// Replace an object in the inventory, for a certain amount of slots
[proc,inv_changeitem](inv $inv, obj $old, namedobj $new, int $slots)
def_int $i = 0;
while ($i < inv_size($inv)) {
    if ($slots < 1) return;
    if (inv_getobj($inv, $i) = $old) {
        inv_setslot($inv, $i, $new, inv_getnum($inv, $i));
        $slots = sub($slots, 1);
    }
    $i = add($i, 1);
}

// Replace a certain amount of an object in the inventory
[proc,inv_changeitem2](inv $inv, obj $old, namedobj $new, int $count)
def_int $i = 0;
while ($i < inv_size($inv)) {
    if ($count < 1) return;
    if (inv_getobj($inv, $i) = $old) {
        inv_setslot($inv, $i, $new, inv_getnum($inv, $i));
        $count = sub($count, inv_getnum($inv, $i));
    }
    $i = add($i, 1);
}
