[if_button,magic:varrock_teleport] @magic_teleport(^varrock_teleport);
[if_button,magic:lumbridge_teleport] @magic_teleport(^lumbridge_teleport);
[if_button,magic:falador_teleport] @magic_teleport(^falador_teleport);
[if_button,magic:camelot_teleport] @magic_teleport(^camelot_teleport);
[if_button,magic:ardougne_teleport] @magic_teleport(^ardougne_teleport);
[if_button,magic:watchtower_teleport] @magic_teleport(^watchtower_teleport);
[if_button,magic:trollheim_teleport] @magic_teleport(^trollheim_teleport);

[label,magic_teleport](int $spell)
if_close;
if (p_finduid(uid) = true) {
    // look for spell in db
    def_dbrow $spell_data = ~get_spell_data($spell);
    if (~check_spell_requirements($spell_data)= false) {
        return;
    }
    if (~wilderness_level(coord) > 20) {
        mes("A mysterious force blocks your teleport spell!");
        mes("You can't use this teleport after level 20 wilderness.");
        return;
    }
    if($spell = ^ardougne_teleport & %elenaquest < ^elena_complete) {
        mes("You must have completed Plague City to use this spell.");
        return;
    }
    if($spell = ^watchtower_teleport & %itwatchtower < ^itwatchtower_complete) {
        mes("You need to have completed the Watchtower Quest to use this spell."); // https://i.imgur.com/FelStNH.png (2006)
        return;
    }
    if($spell = ^trollheim_teleport & %eadgar_quest < ^eadgar_complete) {
        mes("You need to have completed the Eadgar's Ruse Quest to use this spell."); // https://wiki.lostcity.rs/images/7/78/Trollheim-tele-message.jpg
        return;
    }  
    // https://www.reddit.com/r/2007scape/comments/b4vdki/watchtower_teleport_not_working_despite/, https://runescape.salmoneus.net/forums/topic/212538-cant-do-ardougne-tele-why-is-it-so/
    if(($spell = ^ardougne_teleport & %elenaquest < ^elena_complete_read_scroll) | ($spell = ^watchtower_teleport & %itwatchtower < ^itwatchtower_complete_read_scroll)) {
        mes("You haven't learnt how to cast this spell yet.");
        return;
    }  
    if (~pre_tele_checks(coord) = false) {
        return;
    }
    if (afk_event = ^true) {
        ~macro_event_general_spawn(~macro_event_set_random);
        return;
    }
    // delete runes and give xp
    ~delete_spell_runes($spell_data);
    ~give_spell_xp($spell_data);
    // give additional affects
    // teleport player. Always a radius of 2
    ~player_teleport_normal(map_findsquare(db_getfield($spell_data, magic_spell_table:tele_coord, 0), 0, 2, ^map_findsquare_lineofwalk));
}

[proc,player_teleport_normal](coord $coord)
if_close;
p_stopaction;
~tele_checks;
sound_synth(teleport_all, 1, 0);
anim(human_castteleport, 0);
spotanim_pl(teleport_casting, 92, 0);
p_delay(1);
if (inv_getobj(worn, ^wearpos_rhand) = trollromance_toboggon_waxed & inv_freespace(inv) <= 0) { // Matches OSRS behaviour
    obj_add(coord, trollromance_toboggon_waxed, 1, 1000);
}
p_delay(0);
~p_telejump_safe($coord);

[proc,p_telejump_safe](coord $coord)
if (stat(hitpoints) = 0) {
    return;
}

//It's not a zone or mapsquare trigger, happens instantly on teleport
if(~inzone_coord_pair_table(mortton_temple_zones, coord) = true) {
    if_openoverlay(null);
}

if (~in_castlewars_game(coord) = true | ~in_castlewars_waitingroom(coord) = true) {
    return;
}
p_telejump($coord);
cam_reset;
anim(null, 0);
// todo: ensure this proc is used for other teleports too
~post_tele_checks;

[proc,post_tele_checks]
~reset_haunted_levers;
def_int $rum = inv_total(inv, karamja_rum);
if ($rum > 0) {
    inv_del(inv, karamja_rum, $rum);
    mes("Your Karamjan rum gets broken and spilled.");
}
if(inv_total(inv, plaguesample) > 0) { // Biohazard plague sample
    inv_del(inv, plaguesample, ^max_32bit_int);
    mes("The plague sample is too delicate...it disintegrates in the crossing.");
}
if (inv_getobj(worn, ^wearpos_rhand) = trollromance_toboggon_waxed) {
    if(inv_freespace(inv) > 0) {
        mes("You remove the sled.");
        ~unequip_trollromance_sled;
    } else {
        mes("You remove the sled. It drops to the ground as you have no space for it.");
        inv_del(worn, trollromance_toboggon_waxed, 1);
        ~unequip_trollromance_sled;
    }
}
~clear_peer_trial_items;
if(inv_total(inv, mm_monkey_in_backpack) > 0) {
    // this does delete all if you have multiple (confirmed on OSRS)
    inv_del(inv, mm_monkey_in_backpack, ^max_32bit_int);
    mes("The monkey in your backpack disappears in a puff of smoke!");
}
~hauntedmine_fungus_crumble;

[proc,tele_checks]()
if(inv_total(inv, thanainabarrel) > 0) {
    inv_del(inv, thanainabarrel, ^max_32bit_int);
    mes("You drop 'Ana in a barrel' before you teleport.");
}

[proc,pre_tele_checks](coord $coord)(boolean)
if (~in_tutorial_island(coord) = true) {
    ~mesbox("You cannot teleport from Tutorial Island!"); // https://youtu.be/tt38tH6X30E?t=64
    return(false);
}
if (~inzone_coord_pair_table(trawler_wreck_zones, $coord) = true) {
    ~mesbox("Water and magic don't mix!|You can't teleport whilst swimming."); // osrs
    return(false);
}
if (~inzone_coord_pair_table(trawler_game_zones, $coord) = true) {
    ~mesbox("You're too far from shore to teleport!"); // osrs
    return(false);
}
if (~inzone_coord_pair_table(random_event_mime_zones, $coord) = true) {
    say("I need to finish my performance!"); // https://www.youtube.com/watch?v=aGIPPPlADys&t=92s
    return(false);
}
if (~inzone_coord_pair_table(random_event_maze_zones, $coord) = true) {
    say("I need to find the center of the maze!"); // https://www.youtube.com/watch?v=SFugJO98ap4
    return(false);
}
if (~in_duel_arena($coord) = true) {
    mes("Coward! You can't teleport from a duel."); //RS3 message: https://archive.org/details/runelibris
    //Colored in #AB0908 in RS3, but was likely not colored in 2004
    return(false);
}
if (~in_castlewars_game(coord) = true | ~in_castlewars_waitingroom(coord) = true) {
    ~mesbox("You can't leave just like that!");
    return(false);
}

if(inv_total(inv, thanainabarrel) > 0) {
    ~chatnpc_specific("Ana (in a Barrel)", anabarrel, "<p,idle>@dbl@-- You can't teleport while holding the barrel, it's just @dbl@too difficult to concentrate. --");
    return (true);
}
return(true);
