[proc,routequest_has_weapons]()(boolean)
if(inv_total(inv, steel_longsword) < 1 | inv_total(inv, steel_sword) < 2 | inv_total(inv, steel_dagger) < 1
    | inv_total(inv, steel_mace) < 1 | inv_total(inv, steel_warhammer) < 1) {
    return (false);
}
return (true);

[queue,routequest_complete]
%routequest = ^routequest_complete;
stat_advance(attack, 6000);
stat_advance(defence, 6000);
stat_advance(strength, 6000);
stat_advance(hitpoints, 6000);
stat_advance(crafting, 6000);
session_log(^log_adventure, "Quest complete: In Search of the Myreque");
~send_quest_complete2(questlist:routequest, steel_sword, 200, ^routequest_questpoints, "'In Search of the Myreque' completed.", "Attack & Defence XP|Strength & Hitpoint XP|Crafting XP|Quick Route to Mort'ton");
