[kittens_mew]
vislevel=hide
name=Crate
desc=Can I hear kittens?
op1=Search
minimap=no
model1=warehouse_shop_crate2
wanderrange=0
timer=25
moverestrict=nomove
blockwalk=all
members=yes

[gertrudescat]
vislevel=hide
