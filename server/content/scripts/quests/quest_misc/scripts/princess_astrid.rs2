[opnpc1,misc_princess_astrid]
if (%misc_quest >= ^misc_complete) {
    @astrid_afterthronequest;
} else if (%misc_quest >= ^misc_talked_to_king) {
    @astrid_duringthronequest;
} else {
    @astrid_beforethronequest;
}

[label,astrid_beforethronequest]
if(%misc_quest = ^misc_complete) ~chatnpc("<p,neutral>Good day, <~get_viking_name>.");
else ~chatnpc("<p,neutral>Good day, <text_gender("Sir", "Madam")>.");
~chatplayer("<p,neutral>Good day, Your Royal Highness.");

[label,astrid_duringthronequest]
if (gender = ^gender_male) {
    switch_int (divide(%misc_affection, 10)) {
        case ^misc_affection_not_started : @astrid_throneofmiscellaniamarriagestage0;
        case ^misc_affection_s1_base : @astrid_throneofmiscellaniamarriagestage1;
        case ^misc_affection_s2_base : @astrid_throneofmiscellaniamarriagestage2;
        case ^misc_affection_s3_base : @astrid_throneofmiscellaniamarriagestage3;
        case ^misc_affection_complete_base : @astrid_throneofmiscellaniamarriagestage4;
    }
} else {
    @astrid_beforethronequest;
}

[label,astrid_throneofmiscellaniamarriagestage0]
~chatnpc("<p,neutral>Good day, <text_gender("Sir", "Madam")>.");
~chatplayer("<p,happy>Good day, Your Royal Highness.");
~chatplayer("<p,quiz>As I'm sure you are aware, your father the King is seeking someone to rule the Kingdom in his stead. I have put myself forward, but in order for me to become ruler...");
~chatnpc("<p,quiz>...you have to marry somebody in the royal family, namely me?");
~chatplayer("<p,neutral>Yes, Your Royal Highness.");
~chatnpc("<p,shifty>You realise, I hope, that I have many suitors.");
~chatplayer("<p,neutral>I take it you are not especially fond of any of them?");
~chatnpc("<p,neutral>That is true. However, I am willing to give you a chance; if you impress me enough, I will consider accepting to marry you.");
%misc_affection = ^misc_affection_s1_step0;

[label,astrid_throneofmiscellaniamarriagestage1]
if (%misc_s1_d1 = 1 & %misc_s1_d2 = 1 & %misc_s1_d3 = 1 & %misc_s1_give = 1 & %misc_s1_emote = 1) {
    @astrid_randomset1finish;
}
if (%misc_s1_d1 = 0) {
    @astrid_randomset1branch1;
} else if (%misc_s1_d2 = 0) {
    @astrid_randomset1branch2;
} else if (%misc_s1_d3 = 0) {
    @astrid_randomset1branch3;
} else {
    @astrid_beforethronequest;
}

[label,astrid_randomset1branch1]
~chatplayer("<p,quiz>So, you practice archery? I see you have a bow mounted on your wall.");
~chatnpc("<p,neutral>Yes; my father thinks it is a cowardly art, but I find there is just as much courage, and more skill, involved in going into combat with just a bow and quiver. What do you think?");
@multi4miscrand(
    "Archers are all cowards!", astrid_archerscowards,
    "Archery is a noble art!", astrid_archerynobleart,
    "You should listen to your father.", astrid_youshouldlistentodaddy
);

[label,astrid_archerscowards]
~chatplayer("<p,angry>Archers are all cowards!");
~chatnpc("<p,angry>I am insulted, sir!");

[label,astrid_archerynobleart]
~chatplayer("<p,happy>Archery is a noble art!");
%misc_s1_d1 = 1;
%misc_affection = add(%misc_affection, 1); 
~chatnpc("<p,neutral>I'm so glad you agree!");

[label,astrid_youshouldlistentodaddy]
~chatplayer("<p,happy>You should listen to your father.");
~chatnpc("<p,sad>I'm sorry you feel that way.");

[label,astrid_randomset1branch2]
~chatplayer("<p,neutral>So, tell me about all these other admirers you have.");
~chatnpc("<p,neutral>They never cease to bother me. They swarm around me like flies, all hoping to win my heart.");
~chatnpc("<p,neutral>Perhaps I should use them for target practice!");
@multi4miscrand(
    "I don't know why they bother...", astrid_whydoyoubother,
    "You monster!", astrid_youmonstertargetpractice,
    "Hahahaha!", astrid_laughingattargetpractice
);

[label,astrid_whydoyoubother]
~chatplayer("<p,quiz>I don't know why they bother...");
~chatnpc("<p,angry>I don't know why YOU bother.");

[label,astrid_youmonstertargetpractice]
~chatplayer("<p,happy>You monster!");
~chatnpc("<p,angry>I was only joking.");

[label,astrid_laughingattargetpractice]
~chatplayer("<p,laugh>Hahahaha!");
~chatplayer("<p,happy>I can hold them still for you if you like.");
%misc_s1_d2 = 1;
%misc_affection = add(%misc_affection, 1); 
~chatnpc("<p,happy>How do you know I wouldn't hit you as well?");
~chatplayer("<p,happy>I have confidence in your skills, Your Royal Highness.");

[label,astrid_randomset1branch3]
~chatplayer("<p,neutral>What do you think of Advisor Ghrim?");
~chatnpc("<p,neutral>He's a bit scary sometimes, but he's always so nice to me! When I was young, I called him Uncle Ghrim.");
@multi4miscrand(
    "I think he's far too grumpy.", astrid_heisgrumpyboi,
    "He's been very helpful.", astrid_heisveryhelpful,
    "No wonder you turned out like this...", astrid_nowonderyouturnout
);

[label,astrid_heisgrumpyboi]
~chatplayer("<p,happy>I think he's far too grumpy.");
~chatnpc("<p,sad>I'm sure he'd lighten up if you were nicer.");

[label,astrid_heisveryhelpful]
~chatplayer("<p,happy>He's been very helpful.");
%misc_s1_d3 = 1;
%misc_affection = add(%misc_affection, 1); 
~chatnpc("<p,happy>Yes, my father made a wise decision when he chose him to be his advisor.");

[label,astrid_nowonderyouturnout]
~chatplayer("<p,happy>No wonder you turned out like this...");
~chatnpc("<p,angry>I'm insulted, Sir!");

[label,astrid_randomset1finish]
~chatnpc("<p,quiz>You are perhaps a more interesting person than I first took you for, Sir...");
~chatnpc("<p,shock>Oh, but I realise you have not yet told me your name!");
~chatplayer("<p,happy>My name is <~get_viking_name>, Your Highness.");
~chatnpc("<p,quiz>Then may I call you <~get_viking_name>, Sir?");
~chatplayer("<p,happy>If I may call you Astrid, Your Royal Highness.");
~chatnpc("<p,quiz>You may call me 'Princess'.");
%misc_affection = ^misc_affection_s2_step0;
~chatplayer("<p,neutral>Very well, Princess.");

[label,astrid_afterdatingmaterial]
~chatnpc("<p,quiz>Good day, <~get_viking_name>.");
~chatplayer("<p,happy>Good day, Princess.");

[label,astrid_throneofmiscellaniamarriagestage2]
if (%misc_s2_d1 = 1 & %misc_s2_d2 = 1 & %misc_s2_d3 = 1 & %misc_s2_give = 1) {
    @astrid_randomset2finish;
}
if (%misc_s2_d1 = 0) {
    @astrid_randomset2branch1;
} else if (%misc_s2_d2 = 0) {
    @astrid_randomset2branch2;
} else if (%misc_s2_d3 = 0) {
    @astrid_randomset2branch3;
} else {
    @astrid_afterdatingmaterial;
}

[label,astrid_randomset2branch2]
~chatplayer("<p,neutral>What would you do if you ruled this Kingdom?");
~chatnpc("<p,neutral>Very little. It's not as if there's much to it... I might try to set up trade with other islands.");
@multi4miscrand(
    "That's not very enterprising.", astrid_notenterprising,
    "That sounds like a good idea.", astrid_goodidea,
    "What a silly idea!", astrid_sillyidea
);

[label,astrid_notenterprising]
~chatplayer("<p,neutral>That's not very enterprising.");
~chatnpc("<p,angry>Fine. You try to do better!");

[label,astrid_goodidea]
~chatplayer("<p,happy>That sounds like a good idea.");
%misc_s2_d2 = 1;
%misc_affection = add(%misc_affection, 1); 
~chatnpc("<p,neutral>Thank you.");

[label,astrid_sillyidea]
~chatplayer("<p,laugh>What a silly idea!");
~chatnpc("<p,angry>Watch it, or you won't get the chance to do better.");

[label,astrid_randomset2branch3]
~chatplayer("<p,neutral>So what's the history of these islands?");
~chatnpc("<p,neutral>Well, nothing very exciting ever happened until my father declared war on Etceteria...");
