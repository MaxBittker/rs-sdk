@multi4miscrand(
    "And you call yourself an archer?", astrid_callyourselfarcher,
    "Hunting the mighty rabbits outside the castle?", astrid_mightyrabbits,
    "I suppose you don't have much opportunity to.", astrid_noopportunity
);

[label,astrid_callyourselfarcher]
~chatplayer("<p,happy>And you call yourself an archer?");
~chatnpc("<p,sad>I take what chance for practice I can get.");

[label,astrid_mightyrabbits]
~chatplayer("<p,happy>Hunting the mighty rabbits outside the castle? Slaying the foul fowl that terrorises the town?");
~chatnpc("<p,angry>That's not funny.");

[label,astrid_noopportunity]
~chatplayer("<p,quiz>I suppose you don't have much opportunity to.");
%misc_s3_d2 = 1;
%misc_affection = add(%misc_affection, 1); 
~chatnpc("<p,happy>Exactly! Perhaps you could take me with you sometime, dear.");

[label,astrid_throneofmiscellaniamarriagestage4]
@astrid_afterthronequest;

[label,astrid_afterthronequest]
if (%misc_finish_gender = ^gender_male) {
    if (gender = ^gender_male) {
        @astrid_engageddialogue;
    } else {
        @astrid_whyareyoufemale;
    }
} else {
    @astrid_beforethronequest;
}

[label,astrid_engageddialogue]
~chatnpc("<p,happy>Hello, dear.");
~chatplayer("<p,quiz>Hello. Have you found a priest for our marriage yet?");
~chatnpc("<p,sad>I'm afraid not, dear. I don't think there is one to be had on these islands for love nor money...");
~chatnpc("<p,happy>Do not fear, though; I shall call for you as soon as one is found.");

[label,astrid_whyareyoufemale]
~chatnpc("<p,sad>Now please, find some way to turn back into a man...");

// // FOR ITEMS

[opnpcu,misc_princess_astrid]
if (gender = ^gender_female) {
    ~chatnpc("<p,neutral>No thank you, Madam.");
    return;
}
if (%misc_affection = ^misc_affection_not_started) {
    ~chatnpc("<p,neutral>No thank you, Sir.");
    return;
}
def_obj $item = last_useitem;
def_int $op;

if (divide(%misc_affection, 10) = ^misc_affection_s1_base) {
    if (oc_category($item) = flowers) {
        if (%misc_s1_give = 1) {
            ~chatnpc("<p,neutral>You've already given me some, but thank you.");
        } else {
            ~chatnpc("<p,happy>Are these for me? Really?");
            $op = ~p_choice2("Yes", 1, "No", 2);
            if($op = 2) @astrid_just_showing_you;

            ~chatplayer("<p,happy>Of course, Your Royal Highness.");
            inv_del(inv, $item, 1);
            mes("You give Princess Astrid the flowers.");
            %misc_s1_give = 1;
            %misc_affection = add(%misc_affection, 1);
            ~chatnpc("<p,happy>Thank you! They're lovely!");
        }
        return;
    }
}

if (divide(%misc_affection, 10) = ^misc_affection_s2_base) {
    if ($item = shortbow | $item = longbow | $item = oak_shortbow | $item = oak_longbow | $item = willow_shortbow | $item = willow_longbow | 
        $item = maple_shortbow | $item = maple_longbow | $item = yew_shortbow | $item = yew_longbow | $item = magic_shortbow | $item = magic_longbow) {
        if (%misc_s2_give = 1) {
            ~chatnpc("<p,neutral>You've already given me one, but thank you.");
        } else {
            ~chatnpc("<p,happy>Is this for me? Really?");
            $op = ~p_choice2("Yes", 1, "No", 2);
            if($op = 2) @astrid_just_showing_you;

            ~chatplayer("<p,happy>Of course, Your Royal Highness.");
            inv_del(inv, $item, 1);
            mes("You give Princess Astrid the bow.");
            %misc_s2_give = 1;
            %misc_affection = add(%misc_affection, 1);
            ~chatnpc("<p,happy>Thank you! It's lovely!");
        }
        return;
    }
}

if (%misc_affection > ^misc_affection_s3_step3 & %misc_s3_d1 = 1 & %misc_s3_d2 = 1 & %misc_s3_d3 = 1 & %misc_s3_emote = 1) {
    if ($item = gold_ring | $item = sapphire_ring | $item = emerald_ring | $item = ruby_ring | $item = diamond_ring | $item = ring_of_life) {
        ~chatnpc("<p,happy>Is this for me? Really?");
        $op = ~p_choice2("Yes", 1, "No", 2);
        if($op = 2) {
            ~chatplayer("<p,happy>No, my darling, I was just showing you.");
            ~chatnpc("<p,sad>Oh, all right.");
            return;
        }
        ~chatplayer("<p,happy>Princess Astrid, will you marry me?");
        inv_del(inv, $item, 1);
        mes("You give Princess Astrid the ring.");
        %misc_affection = ^misc_affection_complete;
        %misc_acceptedtomarry = 1;
        %misc_finish_gender = 0; // 0 for male
        ~chatnpc("<p,happy>Oh, my dear, I thought you'd never ask! Of course I'll marry you!");
        ~chatnpc("<p,happy>We'll have to put off the actual ceremony until we can find a priest, but you can tell my father I have agreed to marry you.");
        return;
    }
}

~chatnpc("<p,neutral>I couldn't possibly accept this.");

[label,astrid_just_showing_you]
~chatplayer("<p,happy>No, I was just showing you.");
~chatnpc("<p,sad>Oh, all right.");

// // FOR EMOTES

[proc,princess_astrid_handle_emote](seq $anim)
if (gender = ^gender_female | %misc_affection = ^misc_affection_not_started) {
    switch_seq ($anim) {
        case emote_bow, emote_wave : ~chatnpc("<p,neutral>Hello!");
        case emote_angry, emote_cry : ~chatnpc("<p,confused>What's wrong?");
        case emote_cheer : ~chatnpc("<p,neutral>If you want to cheer someone on, Sir, I suggest you find my brother.");
        case emote_beckon : ~chatnpc("<p,neutral>I'm staying right here.");
        case emote_laugh : ~chatnpc("<p,confused>What's so funny?");
        case emote_dance : ~chatnpc("<p,neutral>You dance well.");
        case emote_blow_kiss : ~chatnpc("<p,neutral>Sorry, but I'm not interested.");
        case emote_clap : ~chatnpc("<p,neutral>If you want to applaud someone, Sir, I suggest you find my brother.");
    }
} else if (divide(%misc_affection, 10) = ^misc_affection_s1_base) {
    switch_seq ($anim) {
        case emote_bow, emote_wave : ~chatnpc("<p,neutral>Hello!");
        case emote_angry, emote_cry : ~chatnpc("<p,neutral>What's wrong, Sir?");
        case emote_cheer : ~chatnpc("<p,neutral>If you want to cheer someone on, Sir, I suggest you find my brother.");
        case emote_beckon : ~chatnpc("<p,neutral>I'm staying right here.");
        case emote_laugh : ~chatnpc("<p,neutral>What's so funny, Sir?");
        case emote_glass_box, emote_climbing_rope, emote_mime_lean, emote_glass_wall : ~chatnpc("<p,neutral>You are silly!");
        case emote_dance : {
            // you can repeatedly use these emotes on any stage in osrs and gain affection
            // which can leave the quest in a bugged state until you switch with Vargas... there isn't any
            // reports of this before the quest update so I assume it was introduced then
            if(%misc_s1_emote = ^false) {
                %misc_s1_emote = 1;
                %misc_affection = add(%misc_affection, 1);
            }
            ~chatnpc("<p,happy>You dance well, Sir.");
        }
        case emote_blow_kiss : ~chatnpc("<p,neutral>Let's not get ahead of ourselves now, Sir?");
        case emote_clap : ~chatnpc("<p,neutral>If you want to applaud someone, Sir, I suggest you find my brother.");
    }
} else if (divide(%misc_affection, 10) = ^misc_affection_s2_base) {
    switch_seq ($anim) {
        case emote_bow, emote_wave : ~chatnpc("<p,neutral>Hello!");
        case emote_angry, emote_cry : ~chatnpc("<p,neutral>What's wrong, <~get_viking_name>?");
        case emote_cheer : ~chatnpc("<p,neutral>If you want to cheer someone on, <~get_viking_name>, I suggest you find my brother.");
        case emote_beckon : ~chatnpc("<p,neutral>I'm staying right here.");
        case emote_laugh : ~chatnpc("<p,neutral>What's so funny, <~get_viking_name>?");
        case emote_glass_box, emote_climbing_rope, emote_mime_lean, emote_glass_wall : ~chatnpc("<p,neutral>You are silly!");
        case emote_dance : ~chatnpc("<p,happy>You dance well, <~get_viking_name>.");
        case emote_blow_kiss : ~chatnpc("<p,neutral>Let's not get ahead of ourselves now, <~get_viking_name>!");
        case emote_clap : ~chatnpc("<p,neutral>If you want to applaud someone, <~get_viking_name>, I suggest you find my brother.");
    }
} else if (divide(%misc_affection, 10) > ^misc_affection_s2_base) {
    switch_seq ($anim) {
        case emote_bow, emote_wave : ~chatnpc("<p,happy>Hello!");
        case emote_angry, emote_cry : ~chatnpc("<p,happy>What's wrong, dear?");
        case emote_cheer : ~chatnpc("<p,happy>If you want to cheer someone on, dear, I suggest you find my brother.");
        case emote_beckon : ~chatnpc("<p,happy>I'm staying right here.");
        case emote_laugh : ~chatnpc("<p,happy>What's so funny, dear?");
        case emote_dance : ~chatnpc("<p,happy>You dance well, dear.");
        case emote_blow_kiss : {
            if(%misc_s3_emote = ^false) {
                %misc_s3_emote = 1;
                %misc_affection = add(%misc_affection, 1);
            }
            ~chatnpc("<p,happy>You flatter me, my dear.");
        }
        case emote_clap : ~chatnpc("<p,happy>If you want to applaud someone, dear, I suggest you find my brother.");
    }
}