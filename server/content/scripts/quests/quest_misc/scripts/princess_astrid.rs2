~chatnpc("<p,neutral>Queen Sigrid of Etceteria insulted him.");
@multi4miscrand(
    "Hahahaha!", astrid_laughingathistory,
    "He probably deserved it.", astrid_hedeservedit,
    "What happened next?", astrid_whathappenednext
);

[label,astrid_laughingathistory]
~chatplayer("<p,laugh>Hahahaha!");
~chatnpc("<p,angry>It's not that funny.");
~chatplayer("<p,laugh>Well excuse me, Princess!");

[label,astrid_hedeservedit]
~chatplayer("<p,neutral>He probably deserved it.");
~chatnpc("<p,angry>I'm insulted, <~get_viking_name>!");

[label,astrid_whathappenednext]
~chatplayer("<p,happy>What happened next?");
%misc_s2_d3 = 1;
%misc_affection = add(%misc_affection, 1); 
~chatnpc("<p,happy>He realised that neither of us have an army.");

[label,astrid_randomset2branch1]
~chatplayer("<p,neutral>So why are you so interested in archery?");
~chatnpc("<p,neutral>I'm not sure. Even when I was little, archery always fascinated me.");
@multi4miscrand(
    "I'm quite fond of it myself.", astrid_fondofitmyself,
    "You should stick to knitting.", astrid_sticktoknitting,
    "You should try swordfighting instead.", astrid_tryswordfighting
);

[label,astrid_fondofitmyself]
~chatplayer("<p,happy>I'm quite fond of it myself.");
%misc_s2_d1 = 1;
%misc_affection = add(%misc_affection, 1); 
~chatnpc("<p,neutral>It's good to know someone who shares my interests.");

[label,astrid_sticktoknitting]
~chatplayer("<p,neutral>You should stick to knitting.");
~chatnpc("<p,angry>I'll knit you a lovely jumper, shall I? It'll keep you warm when I have you exiled to the icelands.");

[label,astrid_tryswordfighting]
~chatplayer("<p,neutral>You should try swordfighting instead.");
~chatnpc("<p,confused>That's not really the kind of thing I'm interested in.");

[label,astrid_randomset2finish]
~chatnpc("<p,happy>I must admit I am growing quite fond of you, <~get_viking_name>.");
~chatplayer("<p,quiz>My, could it be that I have succeeded where so many before me have failed, and finally melted the heart of the fair Princess?");
%misc_affection = ^misc_affection_s3_step0;
~chatnpc("<p,happy>Not yet, my dear; let us just say you have made it onto the shortlist.");

[label,astrid_almostweddingmaterial]
~chatnpc("<p,happy>Hello, dear.");
~chatplayer("<p,happy>Good day, Princess.");

[label,astrid_throneofmiscellaniamarriagestage3]
// You end by giving a ring.
if (%misc_s3_d1 = 0) {
    @astrid_randomset3branch1;
} else if (%misc_s3_d2 = 0) {
    @astrid_randomset3branch2;
} else if (%misc_s3_d3 = 0) {
    @astrid_randomset3branch3;
} else {
    @astrid_almostweddingmaterial;
}

