[ai_timer,mm_demon]
if(finduid(%npc_aggressive_player) = false) {
    npc_del;
    return;
}
if(inzone(1_42_143_0_0, 1_42_143_63_63, coord) = false) {
    npc_del;
}

[opnpc2,mm_demon]
if (%npc_aggressive_player ! uid) {
    mes("That is not your enemy!");
    return;
}
@player_combat_start;

[apnpc2,mm_demon] 
if (%npc_aggressive_player ! uid) {
    mes("That is not your enemy!");
    return;
}
@player_combat_start_ap;

[ai_queue1,mm_demon] ~npc_default_retaliate_ap;
[ai_opplayer2,mm_demon] npc_setmode(applayer2);
[ai_applayer2,mm_demon] @mm_demon_attack;

[label,mm_demon_attack]
if (%npc_action_delay > map_clock) {
    return;
}
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) {
    return;
}

def_int $spell;
def_synth $success;
def_synth $fail;
switch_int(random(4)) {
    case 0 :
        $spell = ^wind_wave;
        $success = wind_wave_all;
        $fail = wind_wave_fail;
    case 1 :
        $spell = ^water_wave;
        $success = water_wave_all;
        $fail = water_wave_fail;
    case 2 :
        $spell = ^earth_wave;
        $success = earth_wave_all;
        $fail = earth_wave_fail;
    case default : 
        $spell = ^fire_wave;
        $success = fire_wave_all;
        $fail = fire_wave_fail;
}
if(npc_range(coord) < 3) { // melee range of 2 :)
    if (random(2) = 0) {
        ~mm_demon_spellcast($spell, $success, $fail);
    } else {
        ~npc_default_attack;
    }
} else {
    ~mm_demon_spellcast($spell, $success, $fail);
}

[proc,mm_demon_spellcast](int $spell, synth $success, synth $fail)
if (~npc_combat_spell_checks = false) {
    return;
}

def_dbrow $spell_data = ~get_spell_data($spell);
def_int $duration = ~npc_spell_cast($spell_data, 4);
def_int $maxhit = 31;

// it will still splash with prot prayer on, seems to just be based on hit roll
if(~check_protect_prayer(^magic_style) = true) {
    $maxhit = 0;
}

// uses the original synths for wave spells, even today
if (~npc_player_hit_roll(^magic_style) = true) {
    if_close;
    sound_synth($success, 0, $duration);
    def_int $damage = randominc($maxhit);
    if ($maxhit ! null) {
        // npc vs player spells have no 1t extra damage delay. Whereas player vs npc spells do (osrs)
        queue(combat_damage_player, calc($duration / 30), $damage);
    }
    spotanim_pl(db_getfield($spell_data, magic_spell_table:spotanim_target, 0), $duration);
    queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
} else {
    if_close;
    sound_synth($fail, 0, $duration);
    // splash sound would play here (still plays here even though the spells use old sounds)
    spotanim_pl(failedspell_impact, 92, $duration);
    // splashing in osrs causes insta auto retal
    queue*(playerhit_n_retaliate, 0)(npc_uid);
}
~npc_set_attack_vars;

[ai_queue3,mm_demon]
gosub(npc_death);
if(npc_findhero = ^true) {
    obj_add(npc_coord, ashes, 1, ^lootdrop_duration);
    // osrs seems to have changed this to happen before death, but the arrow is still set to garkor after death
    if(%mm_main = ^mm_completed_ch3) {
        queue(queue_defeat_jungledemon, 0, 0);
    }
}

[queue,queue_defeat_jungledemon]
~music_jingle("mission over");
%mm_main = ^mm_defeated_demon;
// if you are far enough away it wont set the arrow on osrs
// https://www.youtube.com/watch?v=YJtoktu_3qk, seems to spawn the npc if this fails?
npc_findallany(coord, 15, 0);
while(npc_findnext = true) {
    if(npc_type = mm_garkor_final_battle & %npc_aggressive_player = uid) {
        hint_npc;
        return;
    }
}
npc_add(map_findsquare(coord, 1, 5, ^map_findsquare_lineofwalk), mm_garkor_final_battle, add(2000, random(200)));
hint_npc;
%npc_aggressive_player = uid;

[ai_queue4,mm_demon]
// for npc damage from the gnomes, if its killing damage it heals instead
def_int $damage = last_int;
if (npc_stat(hitpoints) = 0) {
    return;
}
if ($damage = 0) {
    npc_damage(^hitmark_block, 0);
} else {
    npc_damage(^hitmark_damage, $damage);
}
if (npc_stat(hitpoints) > 0) {
    return;
}
npc_statheal(hitpoints, 0, 15);

