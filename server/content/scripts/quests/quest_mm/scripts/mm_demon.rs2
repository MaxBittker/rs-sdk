[opheld2,mm_sigil]
// https://youtu.be/ZKOuCipODy4?si=Vcb3N2kwH6bf2IdM&t=4
// seems to match how ash describes it working, is updated in 2007 to teleport on opheld2 without equiping
settimer(teleport_mm_sigil, 10);
~equip(last_slot);

[proc,mm_sigil_valid_teleport]()(boolean)
if (~wilderness_level(coord) > 0) {
    mes("You cannot teleport out of the wilderness using the sigil."); // anywhere in wilderness
    return (false);
}
if (~pre_tele_checks(coord) = false) {
    return (false);
}

[timer,teleport_mm_sigil]
cleartimer(teleport_mm_sigil);
if(%mm_main >= ^mm_defeated_demon)  {
    mes("The sigil doesn't activate as you have already helped the");
    mes("10th squad defeat the demon.");
    return;
}
if(inzone(0_42_143_0_0, 2_42_143_63_63, coord) = true) {
    mes("You are already helping the 10th squad defeat the demon!");
    return;
}
if (~mm_sigil_valid_teleport = false) {
    settimer(teleport_mm_sigil, 10);
    return;
}
mes("The 10th squad sigil begins to shake violently!");
%mm_waiting_for_final_battle = ^true;
~.sound_area(rumbling, 0, coord, 5);
cam_shake(0, 10, 0, 0);
// determine coord to spawn on, this happens before the teleport
// todo: im not 100% sure on this since i dont have 5 accs to test
// but it will always use SW and then NE if someone is already 9 tiles within the SW corner
def_int $player_count_sw = 0;
def_int $player_count_ne = 0;
def_int $player_count_se = 0;
def_int $player_count_nw = 0;
huntall(1_42_143_14_21, 9, 0);
while(huntnext = true) {
    $player_count_sw = add($player_count_sw, 1);
}

huntall(1_42_143_41_48, 9, 0);
while(huntnext = true) {
    $player_count_ne = add($player_count_ne, 1);
}

huntall(1_42_143_12_50, 9, 0);
while(huntnext = true) {
    $player_count_se = add($player_count_se, 1);
}

huntall(1_42_143_41_21, 9, 0);
while(huntnext = true) {
    $player_count_nw = add($player_count_nw, 1);
}

def_int $lowest_count = $player_count_sw;
%mm_cutscene_coord = 1_42_143_14_21;

if ($player_count_ne < $lowest_count) {
    $lowest_count = $player_count_ne;
    %mm_cutscene_coord = 1_42_143_41_48;
}

if ($player_count_se < $lowest_count) {
    $lowest_count = $player_count_se;
    %mm_cutscene_coord = 1_42_143_12_50;
}

if ($player_count_nw < $lowest_count) {
    $lowest_count = $player_count_nw;
    %mm_cutscene_coord = 1_42_143_41_21;
}

p_delay(5); // 6t
~fade_out;
~tele_checks;
~music_setvar(8, 21);
if_settext(music:com_177, "Showdown");
midi_song("showdown");
cam_reset;
sound_synth(teleport_all, 1, 0);
anim(human_castteleport, 0);
spotanim_pl(teleport_casting, 92, 0);
p_delay(3);
~p_telejump_safe(%mm_cutscene_coord);
p_delay(0);
~fade_in;
sound_synth(rumbling_loop, 4, 0);
cam_shake(0, 10, 0, 0);
cam_moveto(1_42_143_27_31, 300, 232, 232);
cam_lookat(1_42_143_27_34, 150, 232, 232);
cam_lookat(1_42_143_27_34, 150, 10, 10);
cam_moveto(1_42_143_27_25, 1000, 2, 0);
p_delay(15);

// duration of gnomes seems to have some randomess?
npc_add(map_findsquare(coord, 1, 5, ^map_findsquare_lineofwalk), mm_garkor_final_battle, add(2000, random(200)));
spotanim_npc(smokepuff_large, 50, 0);
%npc_aggressive_player = uid;

npc_add(map_findsquare(coord, 1, 5, ^map_findsquare_lineofwalk), mm_lumo_final_battle, add(2000, random(200)));
spotanim_npc(smokepuff_large, 50, 0);
%npc_aggressive_player = uid;

npc_add(map_findsquare(coord, 1, 5, ^map_findsquare_lineofwalk), mm_bunkdo_final_battle, add(2000, random(200)));
spotanim_npc(smokepuff_large, 50, 0);
%npc_aggressive_player = uid;

npc_add(map_findsquare(coord, 1, 5, ^map_findsquare_lineofwalk), mm_carado_final_battle, add(2000, random(200)));
spotanim_npc(smokepuff_large, 50, 0);
%npc_aggressive_player = uid;

// todo: lumdo, bunkwicket, waymottin don't have a final battle npc until 295ish
// zooknock's has no ops or walk/ready seq, so he likely uses his regular version as well
// need to convert these to use their final_battle versions instead once we get there
// (interestingly these all use ap range/magic attacks, and carado is also changed to use range later)
npc_add(map_findsquare(coord, 1, 5, ^map_findsquare_lineofwalk), mm_lumdo, add(2000, random(200)));
spotanim_npc(smokepuff_large, 50, 0);
%npc_aggressive_player = uid;

npc_add(map_findsquare(coord, 1, 5, ^map_findsquare_lineofwalk), mm_karam_final_battle, add(2000, random(200)));
spotanim_npc(smokepuff_large, 50, 0);
%npc_aggressive_player = uid;

npc_add(map_findsquare(coord, 1, 5, ^map_findsquare_lineofwalk), mm_bunkwicket, add(2000, random(200)));
spotanim_npc(smokepuff_large, 50, 0);
%npc_aggressive_player = uid;

npc_add(map_findsquare(coord, 1, 5, ^map_findsquare_lineofwalk), mm_waymottin, add(2000, random(200)));
spotanim_npc(smokepuff_large, 50, 0);
%npc_aggressive_player = uid;

npc_add(map_findsquare(coord, 1, 5, ^map_findsquare_lineofwalk), mm_zooknock_final_battle, add(2000, random(200)));
spotanim_npc(smokepuff_large, 50, 0);
%npc_aggressive_player = uid;

queue(garkor_final_battle, 0, 0);
cam_reset;

[queue,garkor_final_battle]
queue(spawn_jungle_demon, 0, 0);
def_int $value = %mm_been_to_final_battle;
if(%mm_been_to_final_battle = ^false) %mm_been_to_final_battle = ^true;

if($value = ^false) ~chatnpc_specific(nc_name(mm_garkor_final_battle), mm_garkor_final_battle, "<p,neutral>Ready yourself, human: the final battle begins!");
else ~chatnpc_specific(nc_name(mm_garkor_final_battle), mm_garkor_final_battle, "<p,neutral>Ready yourself, human: the final battle begins... again!");

[queue,spawn_jungle_demon]
%mm_waiting_for_final_battle = ^false;
if(inzone(1_42_143_0_0, 1_42_143_63_63, coord) = false) {
    return;
}
// no size checks by the way, it can spawn in a location where its unable to walk
npc_add(map_findsquare(coord, 5, 10, ^map_findsquare_lineofwalk), mm_demon, 2000);
%npc_lastcombat = sub(^max_32bit_int, 8);
%npc_aggressive_player = uid;
npc_anim(demon_appear, 0);
npc_setmode(applayer2);
hint_npc;

[ai_timer,mm_garkor_final_battle] ~gnome_finalbattle_ophunt;
[ai_opnpc2,mm_garkor_final_battle] ~gnome_finalbattle_melee;

[ai_timer,mm_bunkdo_final_battle] ~gnome_finalbattle_ophunt;
[ai_opnpc2,mm_bunkdo_final_battle] ~gnome_finalbattle_melee;

[ai_timer,mm_lumo_final_battle] ~gnome_finalbattle_ophunt;
[ai_opnpc2,mm_lumo_final_battle] ~gnome_finalbattle_melee;

[ai_timer,mm_karam_final_battle] ~gnome_finalbattle_ophunt;
[ai_opnpc2,mm_karam_final_battle] ~gnome_finalbattle_melee;

// uses bow later (when the others are added)
[ai_timer,mm_carado_final_battle] ~gnome_finalbattle_ophunt;
[ai_opnpc2,mm_carado_final_battle] ~gnome_finalbattle_melee;

// the final_battle version uses a bow, the standard uses a sword (change to ap when moving to final_battle variant)
[ai_timer,mm_lumdo]
if(inzone(0_42_143_0_0, 2_42_143_63_63, npc_coord) = false) {
    return;
}
~gnome_finalbattle_ophunt;

[ai_opnpc2,mm_lumdo] ~gnome_finalbattle_melee;

[ai_apnpc2,mm_waymottin] ~gnome_finalbattle_vial;
[ai_apnpc2,mm_bunkwicket] ~gnome_finalbattle_vial;

[ai_timer,mm_zooknock_final_battle]  ~gnome_finalbattle_aphunt;
[ai_apnpc2,mm_zooknock_final_battle]
npc_anim(m_mage_attack, 0);
def_int $duration = 64;
def_spotanim $spell = fireblast_travel;
def_spotanim $spell_impact = fireblast_impact;
if(random(2) = 0) {
    $spell = waterblast_travel;
    $spell_impact = waterblast_impact;
}
$duration = ~npc_to_npc_projectile(.npc_uid, $spell, 25, 50, 25, 16, 21, 64, 5);
npc_setmode(null);
.spotanim_npc($spell_impact, 200, $duration);
.npc_queue(4, random(2), calc($duration / 30));
.npc_anim(demon_block, calc($duration / 30));
~.sound_area(black_demon_hit, calc($duration / 30), .npc_coord, 15);

[proc,gnome_finalbattle_ophunt]
if(finduid(%npc_aggressive_player) = false) {
    npc_del;
    return;
}
if(inzone(1_42_143_0_0, 1_42_143_63_63, coord) = false) {
    npc_del;
    return;
}
npc_huntall(npc_coord, 5, 0);
while(.npc_findnext = true) {
    if(.npc_type = mm_demon & .%npc_aggressive_player = %npc_aggressive_player) {
        npc_setmode(opnpc2);
    }
}

[proc,gnome_finalbattle_aphunt]
if(finduid(%npc_aggressive_player) = false) {
    npc_del;
    return;
}
if(inzone(1_42_143_0_0, 1_42_143_63_63, coord) = false) {
    npc_del;
    return;
}
npc_huntall(npc_coord, 5, 0);
while(.npc_findnext = true) {
    if(.npc_type = mm_demon & .%npc_aggressive_player = %npc_aggressive_player) {
        npc_setmode(apnpc2);
    }
}

[proc,gnome_finalbattle_melee]
