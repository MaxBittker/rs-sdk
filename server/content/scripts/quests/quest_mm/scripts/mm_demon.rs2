else npc_anim(midget_attacksword, 0);
npc_setmode(null);
.npc_queue(4, random(2), 0); // always 1 damage on osrs, not originally: https://youtu.be/9bwZbgPNaOc?si=gmpIpGkKsQdVfXhJ&t=158
.npc_anim(demon_block, 20);
~.sound_area(black_demon_hit, 20, .npc_coord, 15);

