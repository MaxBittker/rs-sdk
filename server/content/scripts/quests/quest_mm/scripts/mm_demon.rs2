[label,open_mm_demon_trapdoor](loc $type)
anim(human_pickupfloor, 0);
p_delay(0);
mes("The trapdoor opens...");
sound_synth(door_open, 1, 0);
loc_change($type, 500);

[label,enter_mm_demon_trapdoor](coord $coord)
~fade_out;
p_delay(3);
p_teleport($coord);
p_delay(0);
~fade_in;
p_delay(3);
if_openoverlay(null);

[opnpc1,mm_garkor_final_battle]
if(%mm_main < ^mm_defeated_demon) {
    ~chatnpcnoturn("<p,angry>Stop talking and start fighting!");
    return;
}
if(%mm_garkor < ^garkor_finished_mission) {
    ~chatnpc("<p,happy>Well done, human! That was a most impressive display of skill.");
    ~chatplayer("<p,neutral>Thank you.");
}
~chatnpc("<p,neutral>You should report to King Narnode immediately. Tell him that the 10th squad still survives and has suffered no casualties.");
// https://youtu.be/Qr9nNWqN6Y8?si=07TYRisnQ7ak9jmU&t=4256
~chatplayer("<p,neutral>Rest assured, I will do so.");
~chatplayer("<p,quiz>How do I leave this place?");
if(%mm_garkor < ^garkor_finished_mission) %mm_garkor = ^garkor_finished_mission;
~chatnpc("<p,neutral>Speak to Zooknock. He will arrange for you to leave.");
npc_findallany(coord, 15, 0);
while(npc_findnext = true) {
    if(npc_type = mm_zooknock_final_battle & %npc_aggressive_player = uid) {
        hint_npc;
        return;
    }
}
npc_add(map_findsquare(coord, 1, 5, ^map_findsquare_lineofwalk), mm_zooknock_final_battle, add(2000, random(200)));
%npc_aggressive_player = uid;
hint_npc;

[opnpc1,mm_zooknock_final_battle]
if(%mm_main < ^mm_defeated_demon) {
    ~chatnpcnoturn("<p,angry>Stop talking and start fighting!");
    return;
}
if(%mm_garkor < ^garkor_finished_mission) {
    ~chatnpc("<p,neutral>You should speak to the Sergeant.");
    return;
}
~chatnpc("<p,neutral>Well done, human. Bear with me now.");
if_close;
p_delay(0);
~fade_out;
sound_synth(teleport_all, 1, 0);
anim(human_castteleport, 0);
spotanim_pl(teleport_casting, 92, 0);
p_delay(3);
p_teleport(map_findsquare(0_42_43_24_32, 0, 7, ^map_findsquare_lineofwalk));
p_delay(0);
anim(null, 0);
~fade_in;
p_delay(1);
if_openoverlay(null);

[opnpc1,mm_bonzara]
~chatnpc("<p,quiz>It looks like you're trying to escape. Would you like some help?");
switch_int(~p_choice2("Yes", 1, "No", 2)) { 
    case 1 :
        ~chatplayer("<p,confused>I ... uh ... yes.");
        ~chatnpc("<p,neutral>Right you are.");
        if_close;
        p_delay(0);
        ~fade_out;
        sound_synth(teleport_all, 1, 0);
        anim(human_castteleport, 0);
        spotanim_pl(teleport_casting, 92, 0);
        p_delay(3);
        p_teleport(map_findsquare(0_42_43_24_32, 0, 7, ^map_findsquare_lineofwalk));
        p_delay(0);
        anim(null, 0);
        ~fade_in;
        p_delay(1);
        if_openoverlay(null);
    case 2 :
        ~chatplayer("<p,confused>No thank you. Who are you by the way?");
        ~chatnpc("<p,neutral>Never mind that child. You should worry more about who you are and the nature of the forces that have driven you here.");
        ~chatplayer("<p,confused>I'll ... keep that in mind, thanks.");
        ~chatnpc("<p,neutral>We WILL meet again, <displayname()>.");
        ~chatplayer("<p,confused>Ok...");
}
