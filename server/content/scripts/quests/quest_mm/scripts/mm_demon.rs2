[proc,gnome_finalbattle_vial]
npc_anim(m_mage_attack, 0);
def_int $duration = 64;
$duration = ~npc_to_npc_projectile(.npc_uid, vial_travel, 25, 50, 25, 16, 21, 64, 5);
npc_setmode(null);
.spotanim_npc(explodingvial, 200, calc($duration / 30));
