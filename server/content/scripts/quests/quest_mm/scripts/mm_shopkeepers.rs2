[opnpc1,mm_hamab]
if(~mm_wearing_greegree = false) {
    ~aa_summon_guards(^true);
    if(inv_total(worn, mm_amulet_of_monkey_speak) = 0) {
        ~mm_monkeyspeak;
    } else {
        ~chatnpc("<p,neutral>Guards! I've found a human!");
    }
    return;
}

if(inv_total(worn, mm_amulet_of_monkey_speak) = 0) {
    ~mm_monkeyspeak;
    ~mesbox("You cannot understand what she is saying.");
    return;
}
~chatnpc("<p,neutral>Would you like to buy or sell some crafting equipment?");
switch_int(~p_choice2("Yes, please.", 1, "No, thanks.", 2)) {
    case 1 :
        ~chatplayer("<p,neutral>Yes, please.");
        ~openshop_activenpc;
    case 2 :
        ~chatplayer("<p,neutral>No, thanks.");
}

