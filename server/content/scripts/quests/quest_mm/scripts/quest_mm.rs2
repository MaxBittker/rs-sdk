[proc,mm_login]
if(inv_total(inv, mm_monkey_in_backpack) > 0) {
    settimer(monkey_backpack_timer, ~random_range(5, 50));
}

// not sure on behaviour for login during cutscenes since these are all reworked (probably since they were very jank...)
// so this is a guess, we're just gonna "complete" the cutscene since its the safest route

// chapter 2
if(inzone(0_40_71_0_0, 0_40_71_63_63, coord) = true) {
    if(%mm_main < ^mm_arrived_atoll) {
        p_teleport(0_43_42_49_19);
        if_settab(magic, ^tab_magic);
        %mm_main = ^mm_arrived_atoll;
        %mm_lumdo = ^lumdo_travelled;
    }
}

// chapter 3
if(inzone(0_41_71_0_0, 0_41_71_63_63, coord) = true) {
    if(%mm_main < ^mm_completed_ch2) {
        p_teleport(%mm_cutscene_coord);
        if_settab(magic, ^tab_magic);
        %mm_main = ^mm_completed_ch2;
        %mm_zooknock = ^zooknock_made_talisman;
    }
}

// chapter 4
if(inzone(1_41_71_0_0, 1_41_71_63_63, coord) = true) {
    if(%mm_main < ^mm_completed_ch3) {
        p_teleport(%mm_cutscene_coord);
        if_settab(magic, ^tab_magic);
        %mm_main = ^mm_completed_ch3;
        %mm_garkor = ^garkor_learned_plan;
    }
}

[label,mm_ch1]
~music_jingle("new chapter");
sound_synth(ooks, 0, 0);
if_settext(inter_199:com_2, ^string_empty);
if_settext(inter_199:com_3, ^string_empty);
if_settext(inter_199:com_4, "Monkey Madness: Chapter 1");
if_setcolour(inter_199:com_4, ^white_rgb);
if_settext(inter_199:com_5, ^string_empty);
if_settext(inter_199:com_6, ^string_empty);
if_setcolour(inter_199:com_6, ^white_rgb);
if_settext(inter_199:com_7, "In which our <text_gender("hero", "heroine")> finds <text_gender("him", "her")>self drawn back into");
if_setcolour(inter_199:com_7, ^white_rgb);
if_settext(inter_199:com_8, "Glough's web of deception and deceit.");
if_setcolour(inter_199:com_8, ^white_rgb);
if_settext(inter_199:com_9, ^string_empty);
if_settext(inter_199:com_10, ^string_empty);
if_settext(inter_199:com_11, ^string_empty);
if_settext(inter_199:com_12, ^string_empty);
if_settext(inter_199:com_13, ^string_empty);
if_openmain(inter_199);

