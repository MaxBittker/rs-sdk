[proc,monkeyspeak_text]()(string)
def_string $dialogue = "";
def_int $word_count = 0;
def_int $roll = 0;
while($word_count < 8) {
    $roll = random(8);
    if($roll = 0) {
        $dialogue = append($dialogue, "Ah Ah! ");
        $word_count = add($word_count, 2);
    } else if($roll = 1) {
        $dialogue = append($dialogue, "Ah Uh Ah! ");
        $word_count = add($word_count, 3);
    } else if($roll = 2) {
        $dialogue = append($dialogue, "Ah! ");
        $word_count = add($word_count, 1);
    } else if($roll = 3) {
        $dialogue = append($dialogue, "Ook Ah Ook! ");
        $word_count = add($word_count, 3);
    } else if($roll = 4) {
        $dialogue = append($dialogue, "Ook Ah Uh! ");
        $word_count = add($word_count, 3);
    } else if($roll = 5) {
        $dialogue = append($dialogue, "Ook Ook! ");
        $word_count = add($word_count, 2);
    } else if($roll = 6) {
        $dialogue = append($dialogue, "Ook! ");
        $word_count = add($word_count, 1);
    } else if($roll = 7) {
        $dialogue = append($dialogue, "Ook. ");
        $word_count = add($word_count, 1);
    }
}
return ($dialogue);

[proc,mm_monkeyspeak]
~chatnpc("<p,neutral><~monkeyspeak_text>");

[label,mm_no_amulet_monkey]
~chatnpc("<p,neutral><~monkeyspeak_text>");
~mesbox("You cannot understand what he is saying.");

[queue,aa_guards_queue]
if(getqueue(aa_guards_queue) > 0) {
    return;
}
~aa_summon_guards(^false);

[proc,aa_summon_guards](int $cooldown_flag)
if(~mm_wearing_greegree = true) {
    return;
}
if(inzone(0_42_42_0_0, 2_43_43_63_63, coord) = false) { // didn't exist on launch?
    return;
}
if($cooldown_flag = ^true) {
    // npcs that have the guards summoned queued (like the aunt or dugopul)
    // will set this var as soon as they call for them and not when the guards appear
    if(%mm_guards_cooldown > map_clock) {
        return;
    }
    %mm_guards_cooldown = add(map_clock, 50);
}
def_npc $main_guard = mm_duke;
switch_int(random(5)) {
    case 0 : $main_guard = mm_oipuis;
    case 1 : $main_guard = mm_uyoro;
    case 2 : $main_guard = mm_ouhai;
    case 3 : $main_guard = mm_uodai;
}

npc_add(map_findsquare(coord, 0, 10, ^map_findsquare_lineofsight), $main_guard, 50);
spotanim_map(smokepuff, npc_coord, 50, 0);
sound_synth(smokepuff, 0, 0);
%npc_aggressive_player = uid;
npc_setmode(opplayer2);

def_coord $main_coord = npc_coord;
def_int $count = 0;
while(random(2) = 0 & $count < 3) {
    npc_add(map_findsquare($main_coord, 1, 1, ^map_findsquare_lineofsight), mm_monkey_guard, 50);
    spotanim_map(smokepuff, npc_coord, 50, 0);
    sound_synth(smokepuff, 0, 0);
    %npc_aggressive_player = uid;
    npc_setmode(opplayer2);
    $count = add($count,1);
}

