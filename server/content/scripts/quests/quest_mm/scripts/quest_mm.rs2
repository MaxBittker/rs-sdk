[walktrigger,mm_ch2_walktrigger]
if(%mm_main >= ^mm_arrived_atoll) {
    return;
}
if(inzone(0_40_71_0_0, 0_40_71_63_63, coord) = false) {
    cam_reset;
    if_settab(magic, ^tab_magic);
    %mm_main = ^mm_arrived_atoll;
    %mm_lumdo = ^lumdo_travelled;
    @mm_ch2;
}
p_stopaction;
walktrigger(mm_ch2_walktrigger);
queue(mm_ch2_cutscene_queue, 0, 0);

[queue,mm_ch2_cutscene_queue]
if(inzone(0_40_71_0_0, 0_40_71_63_63, coord) = false) {
    return;
}
%mm_cutscene_part = add(%mm_cutscene_part, 1);
@mm_ch2_cutscene_dialogue;

[label,mm_ch2_cutscene_dialogue]
if(npc_findexact(0_40_71_43_38, mm_foreman_cutscene) = false | .npc_findexact(0_40_71_43_36, mm_caranock_cutscene) = false) {
    cam_reset;
    if_settab(magic, ^tab_magic);
    p_teleport(%mm_cutscene_coord);
    %mm_main = ^mm_arrived_atoll;
    %mm_lumdo = ^lumdo_travelled;
    @mm_ch2;
}
if(%mm_cutscene_part = 0) {
    %mm_cutscene_part = add(%mm_cutscene_part, 1);
    ~chatnpcnoturn("<p,shifty>The workers are getting restless, Caranock.");
}
if(%mm_cutscene_part = 1) {
    %mm_cutscene_part = add(%mm_cutscene_part, 1);
    ~.chatnpc("<p,shifty>I know...");
}
if(%mm_cutscene_part = 2) {
    %mm_cutscene_part = add(%mm_cutscene_part, 1);
    ~chatnpc("<p,shifty>All this talk of Glough being replaced doesn't bode well for ... how shall I put this ... their morale.");
}
if(%mm_cutscene_part = 3) {
    %mm_cutscene_part = add(%mm_cutscene_part, 1);
    ~.chatnpc("<p,angry>Look, I know.");
}
if(%mm_cutscene_part = 4) {
    %mm_cutscene_part = add(%mm_cutscene_part, 1);
    ~chatnpc("<p,angry>Those are all men with children to feed. Famished families. Worried wives. All of us rely on this shipyard.");
}
if(%mm_cutscene_part = 5) {
    %mm_cutscene_part = add(%mm_cutscene_part, 1);
    ~chatnpc("<p,angry>If something isn't done soon, there'll be revolt. And I won't be able to stop it.");
}
if(%mm_cutscene_part = 6) {
    %mm_cutscene_part = add(%mm_cutscene_part, 1);
    ~.chatnpc("<p,angry>Stop worrying. I'm working on something -");
}
if(%mm_cutscene_part = 7) {
    %mm_cutscene_part = add(%mm_cutscene_part, 1);
    ~chatnpc("<p,angry>What something? You're always working on something. All we ever hear is bad news.");
}
if(%mm_cutscene_part = 8) {
    %mm_cutscene_part = add(%mm_cutscene_part, 1);
    ~chatnpc("<p,angry>First, Glough disappears. Then news of a missing squad of the Royal Guard in our area. And what about that human sent by the King?");
}
if(%mm_cutscene_part = 9) {
    %mm_cutscene_part = add(%mm_cutscene_part, 1);
    ~.chatnpc("<p,angry>The human means nothing. If it becomes too much trouble, I will simply have it ... removed. In the meantime, let it continue to search for that blasted 10th squad.");
}
if(%mm_cutscene_part = 10) {
    %mm_cutscene_part = add(%mm_cutscene_part, 1);
    ~chatnpc("<p,neutral>I am still worried. What am I meant to tell the men?");
}
if(%mm_cutscene_part = 11) {
    %mm_cutscene_part = add(%mm_cutscene_part, 1);
    ~.chatnpc("<p,angry>Stop worrying. I'm working on something - Glough left a few of his agents in the Gnome airforce.");
}
if(%mm_cutscene_part = 12) {
    %mm_cutscene_part = add(%mm_cutscene_part, 1);
    ~.chatnpc("<p,neutral>For now, tell your men to continue work on the battleships. Give me some time.");
}
if(%mm_cutscene_part = 13) {
    %mm_cutscene_part = add(%mm_cutscene_part, 1);
    ~chatnpc("<p,neutral>I hope you're right, Caranock, for your sake. My sake. For all of our sakes...");
}
if(%mm_cutscene_part > 13) {
    if_close;
    ~fade_out;
    p_delay(4);
    %mm_cutscene_part = 0;
    if_settab(magic, ^tab_magic);
    cam_reset;
    p_teleport(0_43_42_49_19);
    %mm_main = ^mm_arrived_atoll;
    %mm_lumdo = ^lumdo_travelled;
    ~fade_in;
    p_delay(4);
    if_openoverlay(null);
    @mm_ch2;
}

[walktrigger,mm_ch3_walktrigger]
if(%mm_main >= ^mm_completed_ch2) {
    return;
}
if(inzone(0_41_71_0_0, 0_41_71_63_63, coord) = false) {
    cam_reset;
    if_settab(magic, ^tab_magic);
    %mm_main = ^mm_completed_ch2;
    %mm_zooknock = ^zooknock_made_talisman;
    @mm_ch3;
}
p_stopaction;
walktrigger(mm_ch3_walktrigger);
queue(mm_ch3_cutscene_queue, 0, 0);

[queue,mm_ch3_cutscene_queue]
if(inzone(0_41_71_0_0, 0_41_71_63_63, coord) = false) {
    return;
}
%mm_cutscene_part = add(%mm_cutscene_part, 1);
@mm_ch3_cutscene_dialogue;

[label,mm_ch3_cutscene_dialogue]
if(npc_findexact(0_41_71_46_15, mm_waydar_cutscene) = true & .npc_findexact(0_41_71_48_15, mm_caranock_cutscene) = true) {
    if(%mm_cutscene_part = 0) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,shifty>It is good of you to meet me, Waydar.");
    }
    if(%mm_cutscene_part = 1) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc("<p,neutral>It is good to see you again, Caranock. It is a strange island these monkeys inhabit.");
    }
    if(%mm_cutscene_part = 2) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,quiz>Well observed. How have you been keeping yourself occupied?");
    }
    if(%mm_cutscene_part = 3) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc("<p,neutral>I am now a Flight Commander. My duties include testing Glough's prototype military glider.");
    }
    if(%mm_cutscene_part = 4) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,neutral>My my. How things have changed somewhat since Glough's time... Now, what of the human?");
    }
    if(%mm_cutscene_part = 5) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc("<p,neutral>The human? Just somebody Narnode appears to have taken a fancy to. It is hard to tell why. I suspect the human was involved with Glough's fall from grace.");
    }
    if(%mm_cutscene_part = 6) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,neutral>You may be right. Never mind - there are greater matters afoot. With Glough gone, it falls to us to continue with his plans.");
    }
    if(%mm_cutscene_part = 7) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,neutral>Also, the shipyard workers are becoming restless.");
    }
    if(%mm_cutscene_part = 8) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc("<p,quiz>I see. What do you have in mind?");
    }
    if(%mm_cutscene_part = 9) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,shifty>Money for me, Waydar, and promotion for you. As you know, the 10th squad of the Royal Guard are slightly worse for wear on this island.");
    }
    if(%mm_cutscene_part = 10) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc("<p,angry>This I know. But I don't see how it leads to money or promotion.");
    }
    if(%mm_cutscene_part = 11) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,shifty>What if they were to die? An entire squad of the Royal Guard goes missing in the jungle of Karamja ... We could blame it on the humans.");
    }
    if(%mm_cutscene_part = 12) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc("<p,shock>Narnode would be furious!");
    }
    if(%mm_cutscene_part = 13) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,shifty>Precisely. He might even order an invasion. At the very least he'll step up the defence. More orders for me, promotion for you.");
    }
    if(%mm_cutscene_part = 14) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc("<p,neutral>Very clever. It might also serve us well to remind Narnode of Bolren's situation.");
    }
    if(%mm_cutscene_part = 15) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,neutral>Ah yes - all that trouble with the Khazard. Last I heard, Bolren had retrieved the orbs of protection. Apparently some human lent their assistance.");
    }
    if(%mm_cutscene_part = 16) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc("<p,neutral>Really? Typical meddling human behaviour. Nevertheless, it will stoke fires of worry. After all, the battle still continues.");
    }
    if(%mm_cutscene_part = 17) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,shifty>I agree. Anyhow, we don't want your human wondering as to your whereabouts. When the time is right, don't hesitate to ... dispose of it.");
    }
    if(%mm_cutscene_part = 18) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc("<p,shifty>Understood. Military gliders are after all an untested form of transport...");
    }
    if(%mm_cutscene_part > 18) {
        if_close;
        %mm_main = ^mm_completed_ch2;
        %mm_zooknock = ^zooknock_made_talisman;
        ~fade_out;
        p_delay(4);
        %mm_cutscene_part = 0;
        if_settab(magic, ^tab_magic);
        cam_reset;
        p_teleport(%mm_cutscene_coord);
        ~fade_in;
        p_delay(4);
        if_openoverlay(null);
        @mm_ch3;
    }
} else {
    cam_reset;
    if_settab(magic, ^tab_magic);
    %mm_main = ^mm_completed_ch2;
    %mm_zooknock = ^zooknock_made_talisman;
    @mm_ch3;
}

[queue,mm_ch3_reset]
if_settab(magic, ^tab_magic);
cam_reset;
@music_play(%currentsong);

[walktrigger,mm_ch4_walktrigger]
if(%mm_main >= ^mm_completed_ch3) {
