}
if(inzone(1_41_71_0_0, 1_41_71_63_63, coord) = false) {
    cam_reset;
    if_settab(magic, ^tab_magic);
    %mm_main = ^mm_completed_ch3;
    %mm_garkor = ^garkor_learned_plan;
    @mm_ch4;
}
p_stopaction;
walktrigger(mm_ch4_walktrigger);
queue(mm_ch4_cutscene_queue, 0, 0);

[queue,mm_ch4_cutscene_queue]
if(inzone(1_41_71_0_0, 1_41_71_63_63, coord) = false) {
    return;
}
%mm_cutscene_part = add(%mm_cutscene_part, 1);
@mm_ch4_cutscene_dialogue;

[label,mm_ch4_cutscene_dialogue]
if(npc_findexact(1_41_71_53_34, mm_waydar_cutscene) = true & .npc_findexact(1_41_71_53_36, mm_caranock_cutscene) = true) {
    if(%mm_cutscene_part = 0) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,neutral>Good evening, Awowogei.");
    }
    if(%mm_cutscene_part = 1) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc_specific(nc_name(mm_awowogei_cutscene), mm_awowogei_cutscene, "<p,neutral>It is always dark here, Gnome. Why have you asked to see me in private?");
    }
    if(%mm_cutscene_part = 2) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc("<p,neutral>Caranock and I have a suggestion to make.");
    }
    if(%mm_cutscene_part = 3) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc_specific(nc_name(mm_awowogei_cutscene), mm_awowogei_cutscene, "<p,neutral>Then be quick about it.");
    }
    if(%mm_cutscene_part = 4) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc("<p,neutral>The foot soldiers of the Royal Guard in your jail...");
    }
    if(%mm_cutscene_part = 5) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,neutral>Would it not be easier if they were somehow just to ... die?");
    }
    if(%mm_cutscene_part = 6) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc_specific(nc_name(mm_awowogei_cutscene), mm_awowogei_cutscene, "<p,neutral>Why would I want to do that? Your king would declare war on my island.");
    }
    if(%mm_cutscene_part = 7) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,neutral>I can assure you he will not. We will lay the blame at the humans' feet.");
    }
    if(%mm_cutscene_part = 8) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,neutral>Narnode will indeed declare war: not against you, but against humankind.");
    }
    if(%mm_cutscene_part = 9) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc("<p,neutral>You are of course welcome to your share of the profits.");
    }
    if(%mm_cutscene_part = 10) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc_specific(nc_name(mm_awowogei_cutscene), mm_awowogei_cutscene, "<p,neutral>Intriguing. I have recently secured an alliance with the northern monkeys, which may prove useful.");
    }
    if(%mm_cutscene_part = 11) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc_specific(nc_name(mm_awowogei_cutscene), mm_awowogei_cutscene, "<p,quiz>What would you have me do?");
    }
    if(%mm_cutscene_part = 12) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,neutral>Kill the foot soldiers and the rest of the 10th squad. My superior has sent you a few tricks which may prove useful.");
    }
    if(%mm_cutscene_part = 13) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc_specific(nc_name(mm_awowogei_cutscene), mm_awowogei_cutscene, "<p,quiz>Such as?");
    }
    if(%mm_cutscene_part = 14) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,neutral>High magic: the ability to summon the entire 10th squad to a single location. And -");
    }
    if(%mm_cutscene_part = 15) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc_specific(nc_name(mm_awowogei_cutscene), mm_awowogei_cutscene, "<p,quiz>Even those who escaped?");
    }
    if(%mm_cutscene_part = 16) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,neutral>Yes. And of course, you will also receive access to one of his 'pets'.");
    }
    if(%mm_cutscene_part = 17) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,neutral>You must be careful with these, as you have only one use of each. Ensure you set your trap well - none must survive lest they spread the truth.");
    }
    if(%mm_cutscene_part = 18) {
        if_close;
        p_delay(1);
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc("<p,quiz>What of my human?");
    }
    if(%mm_cutscene_part = 19) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc_specific(nc_name(mm_awowogei_cutscene), mm_awowogei_cutscene, "<p,angry>What human??");
    }
    if(%mm_cutscene_part = 20) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,neutral>Ignore <text_gender("him", "her")>. My colleague's official mission was to look after a human in the area, but don't worry: it is probably dead already.");
    }
    if(%mm_cutscene_part = 21) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc_specific(nc_name(mm_awowogei_cutscene), mm_awowogei_cutscene, "<p,angry>I should hope so, for both of your sakes.");
    }
    if(%mm_cutscene_part = 22) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc_specific(nc_name(mm_awowogei_cutscene), mm_awowogei_cutscene, "<p,neutral>Very well. I shall let you know when I have dealt with the Royal Guard.");
    }
    if(%mm_cutscene_part = 23) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~.chatnpc("<p,neutral>Good luck, Awowogei.");
    }
    if(%mm_cutscene_part = 24) {
        %mm_cutscene_part = add(%mm_cutscene_part, 1);
        ~chatnpc_specific(nc_name(mm_awowogei_cutscene), mm_awowogei_cutscene, "<p,neutral>With access to one of Glough's 'pets', I don't think I'll need it...");
    }

    if(%mm_cutscene_part > 24) {
        if_close;
        %mm_main = ^mm_completed_ch3;
        ~fade_out;
        p_delay(4);
        %mm_cutscene_part = 0;
        if_settab(magic, ^tab_magic);
        cam_reset;
        p_teleport(%mm_cutscene_coord);
        ~fade_in;
        p_delay(4);
        if_openoverlay(null);
        %mm_garkor = ^garkor_learned_plan;
        @mm_ch4;
    }
} else {
    cam_reset;
    if_settab(magic, ^tab_magic);
    %mm_garkor = ^garkor_learned_plan;
    @mm_ch4;
}


