[label,mm_ch2_cutscene]
if_close;
p_delay(0);
%mm_cutscene_coord = coord;
~music_jingle("meanwhile");
queue(mm_ch2_reset, 0, 0);
if_settext(inter_199:com_2, ^string_empty);
if_settext(inter_199:com_3, ^string_empty);
if_settext(inter_199:com_4, ^string_empty);
if_settext(inter_199:com_5, ^string_empty);
if_settext(inter_199:com_6, ^string_empty);
if_setcolour(inter_199:com_6, ^white_rgb);
if_settext(inter_199:com_7, "Meanwhile, far away in Karamja...");
if_setcolour(inter_199:com_7, ^white_rgb);
if_settext(inter_199:com_8, ^string_empty);
if_settext(inter_199:com_9, ^string_empty);
if_settext(inter_199:com_10, ^string_empty);
if_settext(inter_199:com_11, ^string_empty);
if_settext(inter_199:com_12, ^string_empty);
if_settext(inter_199:com_13, ^string_empty);
if_setcolour(scroll:com_3, ^yellow_rgb);
if_setcolour(scroll:com_3, ^yellow_rgb);
if_openmain(inter_199);
~fade_out;
p_delay(4);
if_close;
if(npc_findexact(0_40_71_43_38, mm_foreman_cutscene) = true & .npc_findexact(0_40_71_43_36, mm_caranock_cutscene) = true) {
    p_teleport(0_40_71_36_37);
    .npc_facesquare(movecoord(.npc_coord, 0, 0, 2));
    npc_facesquare(movecoord(npc_coord, 0, 0, -2));
    p_delay(0);
    %mm_cutscene_part = 0;
    walktrigger(mm_ch2_walktrigger);
    ~music_setvar(8, 20);
    if_settext(music:com_177, "Suspicious");
    midi_song("suspicious");
    cam_moveto(0_40_71_39_37, 400, 232, 232);
    cam_lookat(0_40_71_49_37, 160, 232, 232);
    ~fade_in;
    if_settab(null, ^tab_magic);
    @mm_ch2_cutscene_dialogue;
}

[queue,mm_ch2_reset]
@music_play(%currentsong);

