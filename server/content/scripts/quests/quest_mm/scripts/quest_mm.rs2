    walktrigger(mm_land_getup);
    ~mesbox("... and fall to the bottom of a very deep cavern!");
} else {
    anim(m_human_catlike_land, 0);
    walktrigger(catlike_land_getup);
    ~mesbox("... and using your catlike agility land on all fours at the bottom of a large cavern!");
}

