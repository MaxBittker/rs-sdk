    anim(human_furnace, 0);
    sound_synth(furnace, 0, 0);
    p_delay(2);
    mes("It becomes hot and a bit gloopy, but not much else happens.");
    return;
}
~displaymessage(^dm_default);

[oplocu,mm_iban_firewall_straight] @opu_mm_firewall;
[oplocu,mm_iban_firewall_diagonal] @opu_mm_firewall;

[label,opu_mm_firewall]
def_int $slot = last_useslot;
if(last_useitem = mm_enchanted_gold_bar) {
    if(inv_total(inv, mm_monkey_amulet_mould) = 0) {
        ~mesbox("You do not have anything suitable for smithing an enchanted gold bar.");
        return;
    }
    anim(human_furnace, 0);
    sound_synth(furnace, 0, 0);
    inv_delslot(inv, $slot);
    p_delay(2);
    mes("You smith the enchanted gold into an amulet.");
    inv_setslot(inv, $slot, mm_amulet_of_monkey_speak_without_string, 1);
    stat_advance(crafting, 2000);
    return;
}
@use_furnace;

[label,mm_string_amulet]
inv_del(inv, mm_amulet_of_monkey_speak_without_string, 1);
inv_del(inv, ball_of_wool, 1);
inv_add(inv, mm_amulet_of_monkey_speak, 1);
stat_advance(crafting, 40);
mes("You put some string on your amulet. It makes a slight 'Ook' sound.");

[oploc1,mm_stairs_base]
p_teleport(movecoord(coord, 0, 1, 4));
mes("You climb up the stairs.");

[oploc1,mm_stairs_top]
p_teleport(movecoord(coord, 0, -1, -4));
mes("You climb down the stairs.");

[oploc1,mm_bananatreeempty]
mes("There are no bananas left on the tree.");

[proc,mm_greegree_zone](coord $coord)(boolean)
if(inzone(0_42_42_0_0, 2_43_43_63_63, $coord) = true | inzone(0_42_142_0_0, 0_43_142_63_63, $coord) = true |
    inzone(0_40_51_32_1, 0_41_51_15_23, $coord) = true | inzone(0_41_71_0_0, 0_41_71_63_63, $coord) = true |
    inzone(0_43_143_0_0, 0_43_143_63_63, $coord) = true) {
    return (true);
}
return (false);

[oploc1,mm_bamboo_largedoor] @open_mm_largedoor;
[oploc1,mm_bamboo_largedoor_left] @open_mm_largedoor;

[label,open_mm_largedoor]
if(~mm_wearing_greegree = false) {
    mes("The gate is too heavy to move!");
    return;
}

if(inv_total(worn, mm_amulet_of_monkey_speak) = 0) {
    ~chatnpc_specific(nc_name(mm_kruk), mm_kruk, "<p,neutral><~monkeyspeak_text>");
} else {
    ~chatnpc_specific(nc_name(mm_kruk), mm_kruk, "<p,angry>Open the gates! A monkey wishes to pass!");
}
sound_synth(ravinegate_open, 0, 0);
if(coordz(coord) > coordz(loc_coord)) {
    if(loc_find(0_42_43_33_14, mm_bamboo_largedoor_left) = true) {
        loc_del(5);
        loc_add(0_42_43_34_14, mm_bamboo_largedoor_open_left, 2, centrepiece_straight, 5);
    }
    if(loc_find(0_42_43_31_14, mm_bamboo_largedoor) = true) {
        loc_del(5);
        loc_add(0_42_43_31_14, mm_bamboo_largedoor_open, 0, centrepiece_straight, 5);
    }
    ~forcemove(movecoord(coord, 0, 0, -3));
} else {
    if(loc_find(0_42_43_33_14, mm_bamboo_largedoor_left) = true) {
        loc_del(5);
        loc_add(0_42_43_34_13, mm_bamboo_largedoor_open_left, 0, centrepiece_straight, 5);
    }
    if(loc_find(0_42_43_31_14, mm_bamboo_largedoor) = true) {
        loc_del(5);
        loc_add(0_42_43_31_13, mm_bamboo_largedoor_open, 2, centrepiece_straight, 5);
    }
    ~forcemove(movecoord(coord, 0, 0, 3));
}
p_delay(0);

[proc,mm_greegree_transmogrify](obj $obj)
if($obj = null) return;
if(oc_category($obj) = mm_greegree) {
    p_transmogrify(oc_param($obj, next_npc_type));
    p_animprotect(^true);
    if_settab(null, ^tab_magic);
    settimer(mm_greegree_timer, 1);
}

[proc,mm_wearing_greegree]()(boolean)
if(inv_totalcat(worn, mm_greegree) > 0) {
    return (true);
}
return (false);

[queue,fade_clear]
if_openoverlay(null);

// regular quest_complete song (osrs just uses ooks)
[queue,mm_quest_complete]
%mm_main = ^mm_complete;
session_log(^log_adventure, "Quest complete: Monkey Madness");
queue(mm_complete_dialogue, 0, 0);
~send_quest_complete(questlist:mm, mm_monkey_in_backpack, 250, ^mm_questpoints, "You have completed the\\n'Monkey Madness' Quest!");

[proc,fade_out]
if_setanim(castlewars_shopside:com_0, null);
if_openoverlay(castlewars_shopside);
if_setobject(castlewars_shopside:com_0, fade_to_black_inv, 1000);
if_setanim(castlewars_shopside:com_0, fade_out);

[proc,fade_in]
if_setanim(castlewars_shopside:com_0, null);
if_openoverlay(castlewars_shopside);
if_setobject(castlewars_shopside:com_0, fade_to_black_inv, 1000);
if_setanim(castlewars_shopside:com_0, fade_in);
