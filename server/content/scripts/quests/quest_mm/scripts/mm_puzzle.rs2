inv_setslot(reinitialisation_inv_inactive, 14, reinitialisation_15_inactive, 1);
inv_setslot(reinitialisation_inv_inactive, 15, reinitialisation_16_inactive, 1);
inv_setslot(reinitialisation_inv_inactive, 16, reinitialisation_17_inactive, 1);
inv_setslot(reinitialisation_inv_inactive, 17, reinitialisation_18_inactive, 1);
inv_setslot(reinitialisation_inv_inactive, 18, reinitialisation_19_inactive, 1);
inv_setslot(reinitialisation_inv_inactive, 19, reinitialisation_20_inactive, 1);
inv_setslot(reinitialisation_inv_inactive, 20, reinitialisation_21_inactive, 1);
