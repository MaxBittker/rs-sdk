[oploc1,mm_jail_door]
mes("You attempt to pick the lock.");
p_delay(2);
if(stat_random(thieving, 95, 295) = false) { // TODO: actual rate
    mes("You fail to pick the lock.");
    return;
}
mes("You manage to pick the lock.");
stat_advance(thieving, 15);
sound_synth(locked, 0, 0);
~open_and_close_door2(mm_jail_door_inactive, ~check_axis(coord, loc_coord, loc_angle), iron_door_open);

[oploc1,mm_jail_door_unpickable]
mes("You attempt to pick the lock.");
p_delay(2);
mes("You fail to pick the lock.");

[opnpc1,mm_aberab] @mm_guard_dialogue;

[opnpc1,mm_trefaji] @mm_guard_dialogue;

[label,mm_guard_dialogue]
if(~mm_wearing_greegree = false) {
    return;
}
if(inv_total(worn, mm_amulet_of_monkey_speak) = 0) {
    @mm_no_amulet_monkey;
} else {
    ~chatnpc("<p,neutral>Grr ... Get out of my way...");
}

[ai_spawn,mm_aberab]
%npc_int = 0;
%npc_int2 = map_clock;

[ai_spawn,mm_trefaji]
%npc_int = 100;

[ai_timer,mm_aberab]
~mm_jail_patrol;

[ai_timer,mm_trefaji]
~mm_jail_patrol;

[queue,aa_jail_knockout]
%mm_player_is_unconscious = ^true;
~fade_out;
p_delay(3);
p_telejump(movecoord(0_43_43_18_41, randominc(6), 0, randominc(1)));
walktrigger(wake_up);
clearqueue(aa_archer_knockout);
clearqueue(aa_guard_knockout);
clearqueue(aa_jail_knockout);
queue(lumo_jailed_dialogue, 10, 0);
if(%mm_jail_count < 255) %mm_jail_count = add(%mm_jail_count, 1);
~fade_in;
p_delay(4);
if_openoverlay(null);

[queue,mm_jail_guard_attack](npc_uid $npc_uid)
clearqueue(mm_jail_guard_attack);
def_coord $dest;
def_coord $npc_center;
def_int $dir;
def_int $dist;
if(npc_finduid($npc_uid) = true) {
        // will still if_close before checking this
        if(lineofsight(coord, npc_coord) = false) {
            return;
        }
        $npc_center = movecoord(npc_coord, 1, 0, 1);

        $dest = coord;
        $dir = ^exact_east;
        if(coordx(coord) < coordx($npc_center) & coordz(coord) < coordz($npc_center)) {
            // southeast
            $dir = ^exact_east;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord(coord, multiply($dist, -1), 0, multiply($dist, -1));
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        } else if(coordx(coord) > coordx($npc_center) & coordz(coord) < coordz($npc_center)) {
            // southwest
            $dir = ^exact_west;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord(coord, $dist, 0, multiply($dist, -1));
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        } else if(coordx(coord) < coordx($npc_center) & coordz(coord) > coordz($npc_center)) {
            // northeast
            $dir = ^exact_east;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord(coord, multiply($dist, -1), 0, $dist);
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        } else if(coordx(coord) > coordx($npc_center) & coordz(coord) > coordz($npc_center)) {
            // northwest
            $dir = ^exact_west;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord(coord, $dist, 0, $dist);
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        } else if(coordx(coord) < coordx($npc_center)) {
            // west
            $dir = ^exact_east;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord(coord, multiply($dist, -1), 0, 0);
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        } else if(coordx(coord) > coordx($npc_center)) {
            // east
            $dir = ^exact_west;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord(coord, $dist, 0, 0);
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        } else if(coordz(coord) < coordz($npc_center)) {
            // south
            $dir = ^exact_north;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord(coord, 0, 0, multiply($dist, -1));
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        } else if(coordz(coord) > coordz($npc_center)) {
            // north
            $dir = ^exact_south;
            $dist = 7;
            while($dist > 0) {
                $dest = movecoord(coord, 0, 0, $dist);
                if(lineofwalk(coord, $dest) = true & coord ! $dest) {
                    $dist = 0;
                } else {
                    $dist = sub($dist, 1);
                }
            }
        }
        anim(human_mm_flyback, 20);
        ~damage_self(divide(stat(hitpoints), 5)); // 1/5th of hp?
        if(lineofwalk(coord, $dest) = true & coord ! $dest) {
            p_exactmove(coord, $dest, 20, 40, $dir);
        }
        strongqueue(aa_jail_knockout, 0, 0);
        p_delay(0);
}

[proc,mm_jail_patrol]
huntall(npc_coord, 1, ^vis_lineofsight);
while(huntnext = true) {
    if(~mm_wearing_greegree = false & %mm_player_is_unconscious = ^false) {
        if (%npc_action_delay <= map_clock) {
            if_close;
            %npc_action_delay = add(map_clock, 4);
            npc_facesquare(coord);
            if(p_finduid(uid) = true) p_delay(0);
            npc_anim(m_gorilla_attack, 0);
            sound_synth(gorilla_bigpunch, 0, 0);
            huntall(coord, 1, ^vis_lineofsight);
            if(huntnext = true) {
                if_close;
                if(busy = false & ~mm_wearing_greegree = false & %mm_player_is_unconscious = ^false) {
                    clearqueue(lumo_jailed_dialogue); // you can stack this queue, but not from getting hit by jail guard multiple times
                    queue*(mm_jail_guard_attack, 0)(npc_uid);
                }
            }
            return;
        }
    }
}

if(%npc_int = 100) {
    return;
}

def_coord $dest;
if(%npc_int < 13) {
    $dest = enum(int, coord, mm_jail_patrol_route, %npc_int);
    if(npc_coord = $dest) {
        %npc_int = add(%npc_int, 1);
        %npc_int2 = add(map_clock, ~mm_jail_patrol_pause($dest, ^false));
    } else if(map_clock >= add(%npc_int2, 6)) { // doesnt arrive 6t after starting -> tele there
        npc_tele($dest);
        %npc_int = add(%npc_int, 1);
        %npc_int2 = add(map_clock, ~mm_jail_patrol_pause($dest, ^true));
    }
}

if(map_clock < %npc_int2) {
    npc_setmode(none);
    npc_walk(npc_coord);
    return;
}

if(%npc_int = 13) {
    npc_setmode(none);
    npc_walk(0_43_43_15_50);
    if(map_clock >= add(%npc_int2, 50)) {
        npc_tele(0_43_43_15_50);
    }
    if(inzone(0_43_43_12_48, 0_43_43_17_52, npc_coord) = true) {
        if(.npc_find(npc_coord, npc_param(next_npc_type), 5, 0) = true) {
            .%npc_int = 0;
            .%npc_int2 = map_clock;
            %npc_int = 100;
            npc_setmode(wander);
        }
    }
    return;
}

npc_setmode(none);
npc_walk(enum(int, coord, mm_jail_patrol_route, %npc_int));


[proc,mm_jail_patrol_pause](coord $coord, int $teleported)(int)
// will not stop at these 2 points unless teleported there
// this will always end up happening on the 2nd last point with the old pathing :)
// https://youtu.be/ZVGTjCbg0lA?si=sdUSoSYwzqWM_Nmv&t=167 (notice the pause)
if($coord = 0_43_43_16_46 | $coord = 0_43_43_18_46) {
    if($teleported = ^false) {
        return(0);
    }
    return(2);
}
return(6);
