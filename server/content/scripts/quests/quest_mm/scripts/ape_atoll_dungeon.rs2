[oploc1,mm_bamboo_ladder_dungeon_entrance]
p_delay(0);
anim(human_pickupfloor, 0);
p_delay(1);
p_teleport(movecoord(coord, 0, 0, 6400));
mes("You climb down the ladder.");

[oploc1,mm_bamboo_ladder_dungeon_exit]
p_delay(0);
anim(human_reachforladder, 0);
p_delay(1);
p_teleport(movecoord(coord, 0, 0, -6400));
mes("You climb up the ladder.");

[oploc1,mm_double_springtrap_trigger]
~mesbox("The rock appears to move slightly as you touch it... It's a trap! You don't see any way to disarm it: maybe you can find a way to cross over it...");

[oplocu,mm_double_springtrap_trigger]
if(last_useitem = woodplank) {
    mes("You place the plank across the flat rock...");
    anim(human_pickupfloor, 0);
    sound_synth(put_down, 0, 0);
    p_delay(1);
    mes("...and quickly walk over.");
    loc_del(5);
    if(coordz(coord) > coordz(loc_coord)) {
        loc_add(loc_coord, mm_crossing_plank, 0, grounddecor, 5);
        p_teleport(movecoord(loc_coord, 0, 0, -1));
    } else if(coordz(coord) < coordz(loc_coord)) {
        loc_add(loc_coord, mm_crossing_plank, 0, grounddecor, 5);
        p_teleport(movecoord(loc_coord, 0, 0, 1));
    } else if(coordx(coord) > coordx(loc_coord)) {
        loc_add(loc_coord, mm_crossing_plank, 1, grounddecor, 5);
        p_teleport(movecoord(loc_coord, -1, 0, 0));
    } else {
        loc_add(loc_coord, mm_crossing_plank, 1, grounddecor, 5);
        p_teleport(movecoord(loc_coord, 1, 0, 0));
    }
    return;
}
~displaymessage(^dm_default);

[timer,mm_dungeon_rocks]
settimer(mm_dungeon_rocks, ~random_range(20, 30));
// zooknock area
if(inzone(0_43_142_49_49, 0_43_142_59_60, coord) = true | inzone(0_42_142_0_0, 0_43_142_63_63, coord) = false) {
    return;
}
%mm_rock_falling = ^true;
cam_shake(0, ~random_range(2, 5), 0, 0);
cam_shake(1, ~random_range(2, 5), 0, 0);
cam_shake(2, ~random_range(2, 5), 0, 0);
sound_synth(rumbling, 0, 0);
queue(mm_dungeon_roof_collapse, 3, 0);

[timer,mm_springtrap]
if (loc_find(coord, mm_double_springtrap_trigger) = true) {
    if(loc_find(movecoord(loc_coord, -1, 0, 0), mm_double_springtrap) = true | loc_find(movecoord(loc_coord, 0, 0, -1), mm_double_springtrap) = true) loc_anim(double_springtrap_release);
    say("Ouch!");
    queue(damage_player, 0, calc(((stat_base(hitpoints) * 8) / 100) + 1));
    world_delay(1); // todo: check delay length
    loc_anim(double_springtrap_reset);
}

[timer,mm_dungeon_spikes]
if (loc_find(coord, mm_floorspikes) = true) {
    if_close;
    if (%poison > -1) { 
        if (%poison = 0) {
            mes("You have been poisoned!");
        }
        ~set_poison_timer;
        %poison = max(%poison, 3);
    } else {
        mes("You are immune to the poison coating the spikes.");
    }
    loc_anim(mm_floorspikes_activate);
    sound_synth(floor_spikes, 0, 0);
    say("Ouch!");
    queue(damage_player, 0, calc(((stat(hitpoints) * 7) / 100) + 1)); // 7% round up
}

[timer,mm_dungeon_wallspikes]
if (loc_find(coord, mm_speartrap) = true) {
    if_close;
    if (%poison > -1) { 
        if (%poison = 0) {
            mes("You have been poisoned!");
        }
        ~set_poison_timer;
        %poison = max(%poison, 3);
    } else {
        mes("You are immune to the poison coating the spikes.");
    }
    loc_anim(speartrap_release);
    sound_synth(floor_spikes, 0, 0);
    say("Ouch!");
    queue(damage_player, 0, calc(((stat(hitpoints) * 7) / 100) + 1)); // 7% round up
}

[queue,mm_dungeon_roof_collapse]
cam_reset;
%mm_rock_falling = ^false;
if(inzone(0_42_142_0_0, 0_43_142_63_63, coord) = false) {
    return;
}
if(map_blocked(movecoord(coord, 0, 1, 0)) = true) return; // under a ledge
spotanim_map(mm_roofcollapse, coord, 0, 0);
strongqueue(damage_player, 0, calc(((stat(hitpoints) * 3) / 100) + 1)); //strongqueue

[mapzone,0_42_142]
if(gettimer(mm_dungeon_rocks) = -1) {
    settimer(mm_dungeon_rocks, ~random_range(20, 30));
}
if(gettimer(mm_dungeon_spikes) = -1) {
    settimer(mm_dungeon_spikes, 1);
}
if(gettimer(mm_dungeon_wallspikes) = -1) {
    settimer(mm_dungeon_wallspikes, 1);
}
if(gettimer(mm_springtrap) = -1) {
    settimer(mm_springtrap, 1);
}
@music_playbyregion(coord);

[mapzone,0_43_142]
if(gettimer(mm_dungeon_rocks) = -1) {
    settimer(mm_dungeon_rocks, ~random_range(20, 30));
}
if(gettimer(mm_dungeon_spikes) = -1) {
    settimer(mm_dungeon_spikes, 1);
}
if(gettimer(mm_dungeon_wallspikes) = -1) {
    settimer(mm_dungeon_wallspikes, 1);
}
if(gettimer(mm_springtrap) = -1) {
    settimer(mm_springtrap, 1);
}
@music_playbyregion(coord);

[mapzoneexit,0_42_142]
def_int $bones_count = inv_total(inv, mm_skeleton_bones);
if(inzone(0_42_142_0_0, 0_43_142_63_63, coord) = false) {
    cleartimer(mm_dungeon_rocks);
    cleartimer(mm_dungeon_spikes);
    cleartimer(mm_dungeon_wallspikes);
    cleartimer(mm_springtrap);
    if($bones_count > 0) {
        inv_del(inv, mm_skeleton_bones, $bones_count);
        inv_add(inv, ashes, $bones_count);
        mes("The skeleton bones you are carrying crumble to dust.");
    }
}

[mapzoneexit,0_43_142]
def_int $bones_count = inv_total(inv, mm_skeleton_bones);
if(inzone(0_42_142_0_0, 0_43_142_63_63, coord) = false) {
    cleartimer(mm_dungeon_rocks);
    cleartimer(mm_dungeon_spikes);
    cleartimer(mm_dungeon_wallspikes);
    cleartimer(mm_springtrap);
    if($bones_count > 0) {
        inv_del(inv, mm_skeleton_bones, $bones_count);
        inv_add(inv, ashes, $bones_count);
        mes("The skeleton bones you are carrying crumble to dust.");
    }
}

[debugproc,monkey]
if(p_finduid(uid) = true) {
    p_transmogrify(mm_transmogrification_normal_monkey);
    readyanim(monkey_ready);
    turnanim(monkey_walk);
    walkanim(monkey_walk);
    walkanim_b(monkey_walk);
    walkanim_l(monkey_walk);
    walkanim_r(monkey_walk);
    runanim(m_normalmonkey_run);
    buildappearance(worn);
}

[debugproc,transmogrify](npc $npc)
if(p_finduid(uid) = true) {
    p_transmogrify($npc);
    buildappearance(worn);
}
