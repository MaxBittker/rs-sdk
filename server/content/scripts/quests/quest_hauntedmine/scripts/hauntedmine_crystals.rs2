[oploc1,hauntedmine_rewarddoor_l] @hauntedmine_rewarddoor_left;
[oplocu,hauntedmine_rewarddoor_l]
if (last_useitem = hauntedmine_reward_key) @hauntedmine_rewarddoor_left;
else ~displaymessage(^dm_default);

[label,hauntedmine_rewarddoor_left]
def_boolean $entering = ~check_axis_locactive(coord);
if (inv_total(inv, hauntedmine_reward_key) < 1 & $entering = true) {
    mes("This door appears to be locked.");
    sound_synth(lockeddoor, 0, 0);
    return;
}
if (inzone(0_43_69_20_33, 0_43_69_21_34, coord) = true & %hauntedmine = ^hauntedmine_boss_defeated) %hauntedmine = ^hauntedmine_rewarddoor_found;
~open_and_close_double_door($entering, ^left);

[oploc1,hauntedmine_rewarddoor_r] @hauntedmine_rewarddoor_right;
[oplocu,hauntedmine_rewarddoor_r]
if (last_useitem = hauntedmine_reward_key) @hauntedmine_rewarddoor_right;
else ~displaymessage(^dm_default);

[label,hauntedmine_rewarddoor_right]
def_boolean $entering = ~check_axis_locactive(coord);
if (inv_total(inv, hauntedmine_reward_key) < 1 & $entering = true) {
    mes("This door appears to be locked.");
    sound_synth(lockeddoor, 0, 0);
    return;
}
if (inzone(0_43_69_20_33, 0_43_69_21_34, coord) = true & %hauntedmine = ^hauntedmine_boss_defeated) %hauntedmine = ^hauntedmine_rewarddoor_found;
~open_and_close_double_door($entering, ^right);

[oploc1,crystalcorner] @hauntedmine_crystal_cut;
[oploc1,crystaledging] @hauntedmine_crystal_cut;
[oploc1,largecrystals] @hauntedmine_crystal_cut;

[oplocu,crystalcorner] @hauntedmine_crystal_u;
[oplocu,crystaledging] @hauntedmine_crystal_u;
[oplocu,largecrystals] @hauntedmine_crystal_u;

[label,hauntedmine_crystal_cut]
if (inv_total(inv, chisel) < 1) {
    mes("You don't have anything suitable for cutting the crystals");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You don't have enough inventory space to hold the crystal.");
    return;
}
mes("You cut a shard from the crystal.");
anim(human_pickuptable, 0);
inv_add(inv, crystalshard_necklace_unstrung, 1);
// not queued
if (%hauntedmine = ^hauntedmine_rewarddoor_found) {
    %hauntedmine = ^hauntedmine_complete;
    stat_advance(strength, 220000);
    ~send_quest_complete(questlist:hauntedmine, crystalshard_necklace, 250, 2, "You have completed the\\nHaunted Mine Quest!");
}

[label,hauntedmine_crystal_u]
if (last_useitem = chisel) @hauntedmine_crystal_cut;
mes("A chisel might be more suitable for cutting these fine crystals.");


// message_game	type=spam, message='You carefully string the shard of crystal.'

[opheldu,crystalshard_necklace_unstrung]
if (last_useitem = ball_of_wool) {
    inv_del(inv, ball_of_wool, 1);
    inv_del(inv, crystalshard_necklace_unstrung, 1);
    inv_add(inv, crystalshard_necklace, 1);
    mes("You carefully string the shard of crystal.");
    return;
}
~displaymessage(^dm_default);

