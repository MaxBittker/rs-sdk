[opnpc1,possessed_pickaxe_stationary] @possessed_pickaxe_aggro;
[ai_applayer2,possessed_pickaxe_stationary]
if (npc_coord ! %npc_start_coord) { // Only attacks if stationary on spawn square in osrs
    npc_setmode(null);
    return;
}
@possessed_pickaxe_aggro;


// Tick 1434	
// sequence	npc=possessed_pickaxe_stationary (3613), id=pickaxe_summon (1446)
// Tick 1487	
// sequence	npc=possessed_pickaxe (3612), id=magicaxe_death (188)
[label,possessed_pickaxe_aggro]
npc_changetype_keepall(possessed_pickaxe, ^max_32bit_int);
npc_anim(pickaxe_summon, 0);
npc_delay(1);
npc_anim(null, 0);
~npc_retaliate(0);


[ai_timer,possessed_pickaxe]
npc_anim(seq_1448, 0); // osrs uses it's death anim.... But it breaks all proceeding anims.
npc_changetype_keepall(possessed_pickaxe_stationary, ^max_32bit_int);
npc_setmode(null);
npc_delay(1);


// Tick 6845	
// sequence	npc=skeletal_miner_sitting (3614), id=skeleton_summon (1443)
// Tick 6898	
// sequence	npc=skeletal_miner (3615), id=skeleton_sitdown (1444)
[ai_applayer2,skeletal_miner_sitting]
npc_changetype_keepall(skeletal_miner, ^max_32bit_int);
npc_anim(skeleton_summon, 0);
npc_delay(1);
npc_anim(null, 0);
~npc_retaliate(0);


// - Itll only revert if its near it's spawn and it hasnt attacked recently
[ai_timer,skeletal_miner]
if (~npc_retal_ready = true & npc_range(%npc_start_coord) < 5) { // skeletal miner only resets if its not in combat
    npc_anim(skeleton_sitdown, 0);
    npc_changetype_keepall(skeletal_miner_sitting, ^max_32bit_int);
    npc_setmode(none); // doesnt resetdefaults
    npc_delay(1);
}



[ai_applayer2,hauntedmine_suprise_ghost_hidden]
npc_changetype_keepall(hauntedmine_suprise_ghost, ^max_32bit_int);
npc_anim(bossghost_fade_in, 0);
npc_delay(1);
npc_anim(null, 0);
// when the ghost enters follow mode, you can attack it right after
// this wouldnt work if %npc_aggressive_player wasnt set (npc_setmode(opplayer2))
~npc_retaliate(0);

[ai_timer,hauntedmine_suprise_ghost]
// If the npc:
// - hasnt attacked in 8 ticks
// - has a target
// - its target is within los
// - its target is within attackrange (2 tiles)
// Then the ghost will change type, and STAY in op mode...

// if not in combat:
// - if hunt target is its own target, revert type and return early... Stays in op mode
// - if hunt target is new, revert normally
// - if no hunt target, fade out and reset normally
// if currently in combat:
// - set mode to playerfollow the hunt target, and set last combat (is this ~npc_retaliate ?)
huntall(npc_coord, 2, ^vis_lineofsight);
if (huntnext = true) { // todo hunt() ?
    if (add(%npc_action_delay, 8) >=  map_clock) { // in combat already
        npc_anim(bossghost_fade_in, 0); // same seq as aggroing
        npc_delay(1);
        npc_setmode(playerfollow); // Doesnt attack player, will retal if attacked (so its not action delay)
        %npc_attacking_uid = null;
        %npc_lastcombat = map_clock;
        return;
    }
    if (uid = %npc_attacking_uid) { // hunt target is current target
        npc_changetype_keepall(hauntedmine_suprise_ghost_hidden, ^max_32bit_int);
        return;
    }
    // The ghost will do this every 52 ticks (incl 2t of delay), even in combat
    npc_anim(bossghost_fade_in, 0); // same seq as aggroing
    npc_delay(1);
    npc_changetype_keepall(hauntedmine_suprise_ghost_hidden, ^max_32bit_int);
    npc_setmode(null);
    return;
}
// no hunt target
npc_anim(bossghost_fade_out, 0);
npc_delay(1);
npc_changetype_keepall(hauntedmine_suprise_ghost_hidden, ^max_32bit_int);
// yea they actually do this... Stays in op mode but will rehunt (engine) anything nearby
npc_sethuntmode(null);



