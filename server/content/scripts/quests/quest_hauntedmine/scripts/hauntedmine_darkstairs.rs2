// Test: smuggle fire into mine with barbarian firemaking
// - No fm checks at all
// - can light torches
// - light sources dont light these up at all, only glowing mushrooms
// - going up lift doesnt extinguish torch

[oploc1,hauntedmine_dark_stairs_top]
// check what stage you can go down here without fungus.
if (inv_total(inv, glowing_fungus) < 1 & %hauntedmine <= ^hauntedmine_lightstairsfound) {
    if (%hauntedmine = ^hauntedmine_liftused) %hauntedmine = ^hauntedmine_darkstairsfound;

    if (loc_coord = 0_42_69_4_20) p_teleport(0_42_71_24_49);
    else if (loc_coord = 0_42_69_58_20) p_teleport(0_42_71_42_19);

    ~chatplayer("<p,neutral>It's kind of dark down here. I should probably find|some form of light before going further.");
    return;
}
if (%hauntedmine = ^hauntedmine_liftused | %hauntedmine = ^hauntedmine_darkstairsfound) %hauntedmine = ^hauntedmine_lightstairsfound;
if (loc_coord = 0_42_69_4_20) p_teleport(0_43_69_6_38);
else if (loc_coord = 0_42_69_58_20) p_teleport(0_43_69_59_38);

[oploc1,hauntedmine_dark_stairs_bottom]
if (loc_coord = 0_42_71_43_17) p_teleport(0_42_69_62_21);
else if (loc_coord = 0_42_71_21_47) p_teleport(0_42_69_3_21);

[oploc1,hauntedmine_light_stairs_bottom]
if (loc_coord = 0_43_69_3_36) p_teleport(0_42_69_3_21);
else if (loc_coord = 0_43_69_60_36) p_teleport(0_42_69_62_21);


