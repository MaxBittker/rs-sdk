[elemental_fire]
name=Fire elemental
desc=A fire elemental.
readyanim=elemental_fire_ready
walkanim=elemental_fire_walk
op2=Attack
vislevel=35
model1=quest_elementalworkshop_npc_fire
attack=35
defence=20
strength=35
hitpoints=30
ranged=20
magic=20
respawnrate=100
param=death_drop,ashes
param=damagetype,^slash_style
param=attack_anim,elemental_fire_attack
param=defend_anim,elemental_fire_defend
param=death_anim,elemental_fire_death
param=attack_sound,fire_elemental_attack
param=defend_sound,fire_elemental_hit
param=death_sound,fire_elemental_death

