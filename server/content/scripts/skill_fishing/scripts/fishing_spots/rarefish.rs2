[opnpc1,_rarefish]
@attempt_fish_lobster;
[opnpc3,_rarefish]
@attempt_fish_swordfish;

// hidden ops
[opnpc4,_rarefish]
@fish_lobster;
[opnpc5,_rarefish]
@fish_swordfish;

[opnpcu,_rarefish]
switch_obj(last_useitem) {
    case harpoon : @attempt_fish_swordfish;
    case lobster_pot : @attempt_fish_lobster;
    case big_net : ~mesbox("The fish here aren't suitable for catching with a big net.");
    case default : @fishing_wrong_spot_message(last_useitem);
}


[label,attempt_fish_lobster]
// check level
if (stat(fishing) < 40) {
    anim(null, 0);
    ~mesbox("You need at least 40 Fishing to catch Lobsters.");
    return;
}
// check if they have fishing equipment
if (~check_fish_equipment(lobster_pot) = false) {
    return;
}

// miscellania
if (inzone(^miscellania_lower_bound, ^miscellania_upper_bound, coord) = true) {
    ~manage_misc_daily_update;
    if(%misc_quest = ^misc_not_started) {
        if (.npc_find(0_40_60_16_12, misc_fisherman, 2, 0) = true) {
            ~.chatnpc("<p,angry>Hey! This is the King's fishing spot. You'll need his approval to make use of it.");
        }
        return;
    }
    if(%misc_approval >= ^MISC_APPROVAL_100_PERCENT) {
        if (.npc_find(0_40_60_16_12, misc_fisherman, 2, 0) = true) {
            if(%misc_quest = ^misc_complete) {
                ~chatnpcnoturn("<p,happy>Don't trouble yourself further, Your Highness, you've already done so much!");
            } else {
                ~chatnpcnoturn("<p,happy>Don't trouble yourself further, <text_gender("Sir", "Madam")>, you've already done so much!");
            }
        }
        return;
    }
}

// check if inv is full
if (inv_freespace(inv) < 1) {
    anim(null, 0);
    ~mesbox("You can't carry any more lobsters.");
    return;
}
if (%action_delay < map_clock) {
    %action_delay = calc(map_clock + 4);
    p_opnpc(1);
    return;
} else if (%action_delay = calc(map_clock + 3)) {
    anim(human_lobster, 0);
    sound_synth(fishing_cast, 1, 20);
    // https://youtu.be/WGq6FZpnH7Y?t=70
    mes("You attempt to catch a Lobster.");
    p_opnpc(4);
} else if (%action_delay = map_clock) { 
    anim(human_lobster, 0);
    ~fish_roll(raw_lobster, null, lobster_pot, null);
}
if (afk_event = ^true & npc_param(is_whirlpool) = ^false) {
    @macro_event_fishing(lobster_pot);
}


