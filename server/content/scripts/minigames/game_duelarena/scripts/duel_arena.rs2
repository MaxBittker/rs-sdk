[applayer1,_]
if (~inzone_coord_pair_table(gnomeball_zones, coord) = true) {
    @pvp_gnomeball_pass;
    return;
}
p_aprange(0);

[opplayer1,_]
if (~inzone_coord_pair_table(gnomeball_zones, coord) = true) {
    @pvp_gnomeball_pass;
    return;
}
if (.busy = true) {
    mes("Other player is busy at the moment."); // https://youtu.be/YkJQDvB14-U?t=26
    return;
}

if (map_members = ^false) { // theres an area f2p worlds have access to that lets you duel other players
    mes(^mes_members_do_that); // guess
    return;
}

if (~in_games_room(coord) = true & ~in_games_room(.coord) = true) {
    // guessing it uses some varp as duel arena challenges

    if (.%duel2accept ! uid) {
        %duel2accept = .uid;
        if (inzone(^draughts_room_start_coord, ^draughts_room_end_coord, coord) = true) {
            %boardgames_game = 0;
            %boardgames_closinginterface = 1;
            %boardgames_timepermove = 1;
            %boardgames_rankedgame = 1;
            %boardgames_piece = 1;
            if_openmain(boardgames_draughts_options);
            %boardgames_closinginterface = 0;
        } else if (inzone(^runelinks_room_start_coord, ^runelinks_room_end_coord, coord) = true) {
            %boardgames_game = 1;
            %boardgames_closinginterface = 1;
            %boardgames_timepermove = 1;
            %boardgames_rankedgame = 1;
            %boardgames_piece = 1;
            if_openmain(boardgames_runelink_options);
            %boardgames_closinginterface = 0;
        } else {
            if_settext(boardgames_challenge:draughts_rank, "<tostring(%boardgames_draughts_rank)> vs <tostring(.%boardgames_draughts_rank)>");
            if_settext(boardgames_challenge:runelink_rank, "<tostring(%boardgames_runelink_rank)> vs <tostring(.%boardgames_runelink_rank)>");
            // if_settext(boardgames_challenge:runesquares_rank, "<tostring(%boardgames_runesquares_rank)> vs <tostring(.%boardgames_runesquares_rank)>");
            // if_settext(boardgames_challenge:runeversi_rank, "<tostring(%boardgames_runeversi_rank)> vs <tostring(.%boardgames_runeversi_rank)>");
            if_openmain(boardgames_challenge);
        }
    } else {
        %duel2accept = .uid;
        %boardgames_game = .%boardgames_game;
        %boardgames_rankedgame = .%boardgames_rankedgame;
        %boardgames_timepermove = .%boardgames_timepermove;
        if (.%boardgames_piece = 1) {
            %boardgames_piece = 2;
        } else {
            %boardgames_piece = 1;
        }
        ~open_boardgames_options;
    }
    return;
}

// prevent people from dueling in a duel or if you arent in the duel area
if (~in_duel_arena(coord) = true | ~inzone_coord_pair_table(duel_arena_zones, coord) = false) {
    mes("You can't do that here."); // https://youtu.be/nUwvlFkcsqA?t=17
    return;
}
// if the other player isnt in the duel area
if (~inzone_coord_pair_table(duel_arena_zones, .coord) = false) {
    mes("That player is not in the duel challenge area."); // https://youtu.be/YlnPnlfgMQ4?t=51
    return;
}

mes("Sending duel offer...");
%dueloptions = 0;
%duel2accept = .uid;

if (.%duel2accept = uid & %duelstatus = ^duelstatus_received) {
    if (.p_finduid(.uid) = true) {
        .p_stopaction;
    }
    %dueloptions = 0;
    if_settext(duel_select_type:status, "");
    if_settext(duel_select_type:otherplayer, "Dueling with: <.displayname>");
    inv_transmit(dueloffer, duel_select_type:inv);
    invother_transmit(.uid, dueloffer, duel_select_type:otherinv);
    inv_transmit(inv, duel_side:inv);

    .if_settext(duel_select_type:status, "");
    .if_settext(duel_select_type:otherplayer, "Dueling with: <displayname>");
    .inv_transmit(dueloffer, duel_select_type:inv);
    .invother_transmit(uid, dueloffer, duel_select_type:otherinv);
    .inv_transmit(inv, duel_side:inv);

    if_openmain_side(duel_select_type, duel_side);
    .if_openmain_side(duel_select_type, duel_side);
    
    %duelstatus = ^duelstatus_reset;
    .%duelstatus = ^duelstatus_reset;
} else {
    .%duelstatus = ^duelstatus_received;
    .mes("<displayname>:duelreq:");
}

[if_close,duel_select_type]
inv_stoptransmit(duel_select_type:inv);
inv_stoptransmit(duel_select_type:otherinv);
inv_stoptransmit(duel_side:inv);


if (.finduid(%duel2accept) = true) {
    .%duel2accept = null;
    .if_close;
    if (%duelstatus ! ^duelstatus_pending_accept & .%duelstatus ! ^duelstatus_pending_accept) {
        .mes("Other player declined stake and duel options."); // 2006 https://youtu.be/HFp6hOkiCns?t=304
    }
}

~moveallinv(dueloffer, inv);
%duel2accept = null;

[if_close,duel_confirm]
inv_stoptransmit(duel_confirm:inv);
inv_stoptransmit(duel_confirm:otherinv);
if (%duelstatus >= ^duelstatus_confirm) { 
    return; // duel accepted
}
if (.finduid(%duel2accept) = true) {
    .if_close;
    .mes("Other player declined stake and duel options."); // 2006 https://youtu.be/HFp6hOkiCns?t=304
    .%duel2accept = null;
}
~moveallinv(dueloffer, inv);
%duel2accept = null;

[if_button,duel_select_type:accept]
%duelstatus = ^duelstatus_pending_accept;
if (.finduid(%duel2accept) = true & ~enough_duel_space = true) { // https://youtu.be/WHpZQ5fbr5w
    if (.%duelstatus = ^duelstatus_pending_accept & ~.enough_duel_space = true) {
        // Accept stake and move onto second screen!
        inv_stoptransmit(duel_select_type:inv);
        inv_stoptransmit(duel_select_type:otherinv);
        inv_stoptransmit(duel_side:inv);

        .inv_stoptransmit(duel_select_type:inv);
        .inv_stoptransmit(duel_select_type:otherinv);
        .inv_stoptransmit(duel_side:inv);

        walktrigger(duel_arena_no_move); // run every time to allow this bug: https://youtu.be/XeLm7FRoYIA
        .walktrigger(duel_arena_no_move);

        cam_reset;
        .cam_reset;

        ~inv_remove_leading_empty_slots(dueloffer);
        ~.inv_remove_leading_empty_slots(dueloffer);

        def_int $tempinvused = sub(inv_size(dueloffer), inv_freespace(dueloffer));
        if ($tempinvused < 1) {
            if_settext(duel_confirm:com_103, "Absolutely nothing!");
            .if_settext(duel_confirm:com_104, "Absolutely nothing!");
        } else {
            if_settext(duel_confirm:com_103, "");
            .if_settext(duel_confirm:com_104, "");

            inv_transmit(dueloffer, duel_confirm:inv);
            .invother_transmit(uid, dueloffer, duel_confirm:otherinv);
        }

        def_int $other_tempinvused = sub(inv_size(dueloffer), .inv_freespace(dueloffer));
        if ($other_tempinvused < 1) {
            if_settext(duel_confirm:com_104, "Absolutely nothing!");
            .if_settext(duel_confirm:com_103, "Absolutely nothing!");
        } else {
            if_settext(duel_confirm:com_104, "");
            .if_settext(duel_confirm:com_103, "");

            invother_transmit(.uid, dueloffer, duel_confirm:otherinv);
            .inv_transmit(dueloffer, duel_confirm:inv);
        }
        if_openmain(duel_confirm);
        .if_openmain(duel_confirm);

        if_settext(duel_confirm:status, "");
        .if_settext(duel_confirm:status, "");

        ~update_duel_confirm_rules;
        ~.update_duel_confirm_rules;

        %duelstatus = ^duelstatus_accept;
        .%duelstatus = ^duelstatus_accept;
    } else {
        .if_settext(duel_select_type:status, "Other player has accepted.");
        if_settext(duel_select_type:status, "Waiting for other player...");
    }
}

[proc,enough_duel_space]()(boolean)
def_int $space_needed = 0;
if (testbit(%dueloptions, ^no_weapons) = ^true) {
    $space_needed = add($space_needed, ~enum_inv_itemspace(worn, inv, duel_arena_weapon_slots));
}
if (testbit(%dueloptions, ^no_armour) = ^true) {
    $space_needed = add($space_needed, ~enum_inv_itemspace(worn, inv, duel_arena_armour_slots));
}
if (testbit(%dueloptions, ^no_jewelry) = ^true) {
    $space_needed = add($space_needed, ~enum_inv_itemspace(worn, inv, duel_arena_jewelry_slots));
}
if ($space_needed > inv_freespace(inv)) {
    if_settext(duel_select_type:status, "You do not have enough space for the items removed.");
    return(false);
}
$space_needed = add($space_needed, ~moveallinv_itemspace2(dueloffer, inv));
$space_needed = add($space_needed, ~both_moveallinv_itemspace2(dueloffer, inv));
if ($space_needed > inv_freespace(inv)) {
    if_settext(duel_select_type:status, "You do not have enough space for the stake.");
    return(false);
}
return(true);

[proc,.enough_duel_space]()(boolean)
def_int $space_needed = 0;
if (testbit(.%dueloptions, ^no_weapons) = ^true) {
    $space_needed = add($space_needed, ~.enum_inv_itemspace(worn, inv, duel_arena_weapon_slots));
}
if (testbit(.%dueloptions, ^no_armour) = ^true) {
    $space_needed = add($space_needed, ~.enum_inv_itemspace(worn, inv, duel_arena_armour_slots));
}
if (testbit(.%dueloptions, ^no_jewelry) = ^true) {
    $space_needed = add($space_needed, ~.enum_inv_itemspace(worn, inv, duel_arena_jewelry_slots));
}
if ($space_needed > .inv_freespace(inv)) {
    .if_settext(duel_select_type:status, "You do not have enough space for the items removed.");
    return(false);
}
$space_needed = add($space_needed, ~.moveallinv_itemspace2(dueloffer, inv));
$space_needed = add($space_needed, ~.both_moveallinv_itemspace2(dueloffer, inv));
if ($space_needed > .inv_freespace(inv)) {
    .if_settext(duel_select_type:status, "You do not have enough space for the stake.");
    return(false);
}
return(true);


[if_button,duel_confirm:accept]
%duelstatus = ^duelstatus_pending_confirm;

if (.finduid(%duel2accept) = true) {
    if (.%duelstatus = ^duelstatus_pending_confirm) {
        mes("Accepted stake and duel options.");
        .mes("Accepted stake and duel options.");

        %duelstatus = ^duelstatus_confirm;
        .%duelstatus = ^duelstatus_confirm;

        if_close;
        .if_close;
        queue(duel_arena_prepare_start, 0, 0);
        .queue(duel_arena_prepare_start, 0, 0);
    } else {
        .if_settext(duel_confirm:status, "Other player has accepted."); // https://youtu.be/HFp6hOkiCns?t=481
        if_settext(duel_confirm:status, "Waiting for other player..."); 
    }
}

[inv_button1,duel_select_type:inv] @removefromduel(last_slot, 1);
[inv_button2,duel_select_type:inv] @removefromduel(last_slot, 5);
[inv_button3,duel_select_type:inv] @removefromduel(last_slot, 10);
[inv_button4,duel_select_type:inv] @removefromduel(last_slot, ^max_32bit_int);
[inv_button5,duel_select_type:inv] @removefromduel(last_slot, null);

[label,removefromduel](int $slot, int $amount)
if ($amount <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $amount = last_int;
}

def_obj $obj = inv_getobj(dueloffer, $slot);
def_int $total = inv_total(dueloffer, $obj);
if ($amount < $total) $total = $amount;
inv_moveitem(dueloffer, inv, $obj, $total);

%duelstatus = ^duelstatus_reset;
if_settext(duel_select_type:status, "");
if (.finduid(%duel2accept) = true) {
    session_log(^log_moderator, "Removed stake <oc_debugname($obj)> x<tostring($total)> to <.name>");
    .%duelstatus = ^duelstatus_reset;
    .if_settext(duel_select_type:status, "");
}

[inv_button1,duel_side:inv] @movetoduel(last_slot, 1);
[inv_button2,duel_side:inv] @movetoduel(last_slot, 5);
[inv_button3,duel_side:inv] @movetoduel(last_slot, 10);
[inv_button4,duel_side:inv] @movetoduel(last_slot, ^max_32bit_int);
[inv_button5,duel_side:inv] @movetoduel(last_slot, null);


[label,movetoduel](int $slot, int $amount)
if ($amount <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $amount = last_int;
}

def_obj $obj = inv_getobj(inv, $slot);

if (oc_tradeable($obj) = false) {
    mes("You can't stake that item."); // RS3 message: https://archive.org/details/runelibris
    return;
}

if (oc_members($obj) = true & map_members = ^false) { // cant duel on f2p worlds anyway but just incase
    mes("You can't stake that item."); // RS3 message: https://archive.org/details/runelibris
    return;
}

def_int $total = inv_total(inv, $obj);
if ($amount < $total) $total = $amount;
inv_moveitem(inv, dueloffer, $obj, $total);

%duelstatus = ^duelstatus_reset;
if_settext(duel_select_type:status, "");
if (.finduid(%duel2accept) = true) {
    session_log(^log_moderator, "Added stake <oc_debugname($obj)> x<tostring($total)> to <.name>");
    .%duelstatus = ^duelstatus_reset;
    .if_settext(duel_select_type:status, "");
}


[proc,duel_arena_checks]()(boolean)
if (~inzone_coord_pair_table(duel_arena_zones, coord) = true & ~in_duel_arena(coord) = false) {
    mes("You cannot attack players in the challenge area."); // https://youtu.be/r606q1TBTJ8?t=53 https://youtu.be/zcFLOWkTSIo?t=3
    return(false);
}
if (.uid ! %duel2accept) {
    mes("You can only attack your opponent!"); // https://storage.googleapis.com/tannerdino/images/batwifahat-purpl.jpg
    return(false);
}
if (%duelstatus < ^duelstatus_start | .%duelstatus < ^duelstatus_start) {
    mes("The duel has not started yet!"); // https://youtu.be/64GEUr-lgS8?t=106
    return(false);
}
return(true);

[proc,in_duel_arena](coord $coord)(boolean)
if (~inzone_coord_pair_table(duel_arena_fight_zones, $coord) = true | ~inzone_coord_pair_table(duel_arena_obstacle_fight_zones, $coord) = true) {
    return(true);
}
return(false);

[proc,.in_duel_arena](coord $coord)(boolean)
if (~.inzone_coord_pair_table(duel_arena_fight_zones, $coord) = true | ~.inzone_coord_pair_table(duel_arena_obstacle_fight_zones, $coord) = true) {
    return(true);
}
return(false);

[proc,duel_arena_login]
if (~in_duel_arena(coord) = false) {
    return;
}
~duel_reset_all;

[proc,duel_arena_logout]
if (~in_duel_arena(coord) = false) {
    return;
}
if (.finduid(%duel2accept) = true) {
    .%duelstatus = ^duelstatus_reset;
    .%duel2accept = null;
    .if_close;
    .queue(duel_arena_disconnect, 0, 0);
}
%duelstatus = ^duelstatus_reset;
%duel2accept = null;
~moveallinv(dueloffer, inv);

[queue,duel_arena_disconnect]
~moveallinv(dueloffer, inv);
~duel_reset_all;
mes("Your opponent timed out, there was no winner!"); // https://storage.googleapis.com/tannerdino/images/00timeout.jpg

[proc,in_duel_arena_challenge_area]()(boolean)
if (~inzone_coord_pair_table(duel_arena_zones, coord) = true & ~in_duel_arena(coord) = false) {
    return(true);
}
return(false);

[queue,check_duel_arena_challenge_area]
if( ~in_duel_arena_challenge_area = true) {
    ~toggle_duel_challenge_on;
} else {
    ~toggle_duel_challenge_off;
}

[proc,toggle_duel_challenge_on]
if_openoverlay(overlay_duel);
set_player_op("Challenge", 1, ^false);
set_player_op(null, 2, ^false);

[proc,toggle_duel_challenge_off]
if_openoverlay(null);
set_player_op(null, 1, ^false);

// Messages are taken from a variety of old sources and are always in the same order
// https://imgur.com/ETH1z4L
// https://youtu.be/1H3z0Qj7rKE?si=_CGn8vmULeJdKQ3B&t=102
[proc,update_duel_confirm_rules]
// defaults
if_settext(duel_confirm:before_rule_line1, "Nothing will be changed.");
if_settext(duel_confirm:before_rule_line2, "");
if_settext(duel_confirm:before_rule_line3, "");
if_settext(duel_confirm:before_rule_line4, "");
if_settext(duel_confirm:before_rule_line5, "");

if_settext(duel_confirm:during_rule_line1, "You will fight using normal combat.");
if_settext(duel_confirm:during_rule_line2, "");
if_settext(duel_confirm:during_rule_line3, "");
if_settext(duel_confirm:during_rule_line4, "");
if_settext(duel_confirm:during_rule_line5, "");
if_settext(duel_confirm:during_rule_line6, "");
if_settext(duel_confirm:during_rule_line7, "");
if_settext(duel_confirm:during_rule_line8, "");
if_settext(duel_confirm:during_rule_line9, "");
if_settext(duel_confirm:during_rule_line10, "");
if_settext(duel_confirm:during_rule_line11, "");

def_int $i = 0;
def_int $current_before_rule_line = 0;
def_int $current_during_rule_line = 0;
def_int $dueloptions_bit_count = 13;
def_string $text = "";

if (testbit(%dueloptions, ^no_weapons) = ^true | testbit(%dueloptions, ^no_armour) = ^true | testbit(%dueloptions, ^no_jewelry) = ^true) {
    $text = "Some worn items will be taken off.";
    if_settext(~get_before_duel_rule_com($current_before_rule_line), $text);
    $current_before_rule_line = add($current_before_rule_line, 1);
}

while ($i <=  $dueloptions_bit_count) {
        //Spec message shows up after no magic mes in all the old sources
    if ($i = 7 & testbit(%dueloptions, ^no_specs) = ^true) {
        $text = "You can not use special attacks."; 
        if_settext(~get_during_duel_rule_com($current_during_rule_line), $text);
        $current_during_rule_line = add($current_during_rule_line, 1);
    }
    if (testbit(%dueloptions, $i) = ^true) {
        $text = ~is_before_duel_rule($i);
        if (string_length($text) > 0) {
            if_settext(~get_before_duel_rule_com($current_before_rule_line), $text);
            $current_before_rule_line = add($current_before_rule_line, 1);
        }

        $text = ~is_during_duel_rule($i);
        if (string_length($text) > 0) {
            if_settext(~get_during_duel_rule_com($current_during_rule_line), $text);
            $current_during_rule_line = add($current_during_rule_line, 1);
        }
    }
    $i = add($i, 1);
}

[proc,.update_duel_confirm_rules]
// defaults
.if_settext(duel_confirm:before_rule_line1, "Nothing will be changed.");
.if_settext(duel_confirm:before_rule_line2, "");
.if_settext(duel_confirm:before_rule_line3, "");
.if_settext(duel_confirm:before_rule_line4, "");
.if_settext(duel_confirm:before_rule_line5, "");

.if_settext(duel_confirm:during_rule_line1, "You will fight using normal combat.");
.if_settext(duel_confirm:during_rule_line2, "");
.if_settext(duel_confirm:during_rule_line3, "");
.if_settext(duel_confirm:during_rule_line4, "");
.if_settext(duel_confirm:during_rule_line5, "");
.if_settext(duel_confirm:during_rule_line6, "");
.if_settext(duel_confirm:during_rule_line7, "");
.if_settext(duel_confirm:during_rule_line8, "");
.if_settext(duel_confirm:during_rule_line9, "");
.if_settext(duel_confirm:during_rule_line10, "");
.if_settext(duel_confirm:during_rule_line11, "");

def_int $i = 0;
def_int $current_before_rule_line = 0;
def_int $current_during_rule_line = 0;
def_int $dueloptions_bit_count = 13;
def_string $text = "";

if (testbit(%dueloptions, ^no_weapons) = ^true | testbit(%dueloptions, ^no_armour) = ^true | testbit(%dueloptions, ^no_jewelry) = ^true) {
    $text = "Some worn items will be taken off.";
    .if_settext(~get_before_duel_rule_com($current_before_rule_line), $text);
    $current_before_rule_line = add($current_before_rule_line, 1);
}

while ($i <=  $dueloptions_bit_count) {
    //Spec message shows up after no magic mes in all the old sources
    if ($i = 7 & testbit(%dueloptions, ^no_specs) = ^true) {
        $text = "You can not use special attacks."; 
        .if_settext(~get_during_duel_rule_com($current_during_rule_line), $text);
        $current_during_rule_line = add($current_during_rule_line, 1);
    }

    if (testbit(%dueloptions, $i) = ^true) {
        $text = ~is_before_duel_rule($i);
        if (string_length($text) > 0) {
            .if_settext(~get_before_duel_rule_com($current_before_rule_line), $text);
            $current_before_rule_line = add($current_before_rule_line, 1);
        }

        $text = ~is_during_duel_rule($i);
        if (string_length($text) > 0) {
            .if_settext(~get_during_duel_rule_com($current_during_rule_line), $text);
            $current_during_rule_line = add($current_during_rule_line, 1);
        }
    }
    $i = add($i, 1);
}

[proc,is_before_duel_rule](int $value)(string)
switch_int($value) {
    case ^no_potions : return("Boosted stats will be restored.");
    case ^no_prayer : return("Existing prayers will be stopped.");
    case default : return("");
}

[proc,is_during_duel_rule](int $value)(string)
switch_int($value) {
    case ^no_forfeit : return("You can not forfeit the duel.");
    case ^no_movement : return("You can not move.");
    case ^no_ranged : return("You can not use ranged attacks.");
    case ^no_melee : return("You can not use melee attacks.");
    case ^no_magic : return("You can not use magic attacks.");
    case ^no_potions : return("You can not use drinks.");
    case ^no_food : return("You can not use food.");
    case ^no_prayer : return("You can not use prayer.");
    case ^flower_power : return("You can only use flowers."); //Guess. Changed to fun weapons later.
    case ^obstacles : return("There will be obstacles in the arena.");
    case default : return("");
}

[proc,get_before_duel_rule_com](int $value)(component)
switch_int($value) {
    case 0 : return(duel_confirm:before_rule_line1);
    case 1 : return(duel_confirm:before_rule_line2);
    case 2 : return(duel_confirm:before_rule_line3);
    case 3 : return(duel_confirm:before_rule_line4);
    case 4 : return(duel_confirm:before_rule_line5);
}

[proc,get_during_duel_rule_com](int $value)(component)
switch_int($value) {
